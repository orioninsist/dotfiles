#!/usr/bin/env bash

export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-}"

rg --line-number --no-heading --color=always \
   --smart-case --hidden \
   --glob '*.md' --glob '*.MD' \
   --glob '!.git/**' \
   -- "${*:-.}" . 2>/dev/null |
fzf --ansi \
    --delimiter ':' \
    --prompt 'Markdown ara > ' \
    --preview 'glow -s dark {1}' \
    --preview-window 'right:60%:wrap' \
    --bind 'enter:become(glow -p {1})'
