#!/usr/bin/env python3
import html, json, os, re, secrets, signal, tempfile, threading, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

HOST, PORT = "127.0.0.1", 8765
MATCH_FILE = Path.home() / ".config/espanso/match/base.yml"
TOKEN = secrets.token_urlsafe(24)

def parse_matches():
    if not MATCH_FILE.exists():
        return []
    text = MATCH_FILE.read_text(encoding="utf-8")
    out = []
    trigger = replace = None
    for line in text.splitlines():
        m = re.match(r'^\s*-\s+trigger:\s*"(.*)"\s*$', line)
        if m:
            if trigger is not None and replace is not None:
                out.append({"trigger": trigger, "replace": replace})
            trigger, replace = m.group(1).replace('\\\"','"').replace('\\\\','\\'), None
            continue
        m = re.match(r'^\s+replace:\s*"(.*)"\s*$', line)
        if m and trigger is not None:
            replace = m.group(1).replace('\\n','\n').replace('\\\"','"').replace('\\\\','\\')
    if trigger is not None and replace is not None:
        out.append({"trigger": trigger, "replace": replace})
    return out

def q(s):
    return '"' + s.replace('\\','\\\\').replace('"','\\\"').replace('\n','\\n') + '"'

def write_matches(items):
    MATCH_FILE.parent.mkdir(parents=True, exist_ok=True)
    body = "matches:\n" + "".join(f"  - trigger: {q(x['trigger'])}\n    replace: {q(x['replace'])}\n\n" for x in items)
    fd, name = tempfile.mkstemp(prefix=".base.", suffix=".yml", dir=MATCH_FILE.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(body)
            f.flush()
            os.fsync(f.fileno())
        os.replace(name, MATCH_FILE)
    finally:
        if os.path.exists(name): os.unlink(name)

PAGE = r'''<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Espanso Snippets</title>
<style>
:root{color-scheme:dark;--bg:#111318;--panel:#191c23;--soft:#222630;--line:#303644;--text:#f1f3f7;--muted:#9da6b7;--accent:#89b4fa;--danger:#f38ba8}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 15% 0,#1b2330 0,transparent 34%),var(--bg);color:var(--text);font:15px/1.45 system-ui,sans-serif}
main{width:min(980px,calc(100% - 32px));margin:54px auto}.top{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}
h1{font-size:30px;margin:0;letter-spacing:-.7px}.sub{color:var(--muted);margin-top:5px}.btn{border:1px solid var(--line);background:var(--soft);color:var(--text);padding:10px 15px;border-radius:10px;cursor:pointer;font-weight:650}.primary{background:var(--accent);color:#11151d;border-color:transparent}
.toolbar{background:color-mix(in srgb,var(--panel) 94%,transparent);border:1px solid var(--line);border-radius:15px;padding:13px;margin-bottom:14px;box-shadow:0 18px 60px #0005}
input,textarea{width:100%;background:#11141a;border:1px solid var(--line);color:var(--text);border-radius:10px;padding:12px 13px;outline:none;font:inherit}input:focus,textarea:focus{border-color:var(--accent)}
.card{display:grid;grid-template-columns:180px 1fr auto;gap:18px;align-items:center;background:var(--panel);border:1px solid var(--line);padding:16px 18px;border-radius:14px;margin:10px 0}
.trigger{font:700 15px ui-monospace,monospace;color:var(--accent)}.replacement{white-space:pre-wrap;overflow-wrap:anywhere}.actions{display:flex;gap:7px}.icon{padding:7px 10px}.danger{color:var(--danger)}
.empty{text-align:center;color:var(--muted);padding:60px 10px}
dialog{width:min(560px,calc(100% - 28px));border:1px solid var(--line);border-radius:16px;background:var(--panel);color:var(--text);padding:0;box-shadow:0 25px 100px #000b}dialog::backdrop{background:#05070aa8;backdrop-filter:blur(4px)}
.modal{padding:22px}.modal h2{margin:0 0 18px}.field{margin:13px 0}.field label{display:block;color:var(--muted);font-size:13px;margin-bottom:6px}.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:20px}
.count{color:var(--muted);font-size:13px;margin:12px 3px}@media(max-width:700px){main{margin-top:25px}.card{grid-template-columns:1fr}.actions{justify-content:flex-end}.top{align-items:flex-start;flex-direction:column}}
</style></head><body><main>
<div class="top"><div><h1>Espanso Snippets</h1><div class="sub">Hızlı ekle, düzenle ve temizle.</div></div><button class="btn primary" onclick="openNew()">+ Yeni snippet</button></div>
<div class="toolbar"><input id="search" placeholder="Trigger veya içerikte ara…" autofocus oninput="render()"></div>
<div id="count" class="count"></div><section id="list"></section>
</main>
<dialog id="modal"><form class="modal" onsubmit="save(event)"><h2 id="title">Yeni snippet</h2>
<div class="field"><label>Trigger</label><input id="trigger" placeholder=":ornek" required></div>
<div class="field"><label>Çıktı</label><textarea id="replace" rows="6" placeholder="Yazılacak metin" required></textarea></div>
<div class="modal-actions"><button type="button" class="btn" onclick="modal.close()">Vazgeç</button><button class="btn primary">Kaydet</button></div>
</form></dialog>
<script>
let items=[], editing=null; const modal=document.querySelector('#modal');
async function load(){items=await (await fetch('/api/snippets')).json();render()}
function render(){const q=document.querySelector('#search').value.toLocaleLowerCase('tr');const f=items.filter(x=>(x.trigger+' '+x.replace).toLocaleLowerCase('tr').includes(q));count.textContent=f.length+' snippet';list.innerHTML=f.length?f.map((x)=>{const i=items.indexOf(x);return '<article class="card"><div class="trigger">'+esc(x.trigger)+'</div><div class="replacement">'+esc(x.replace)+'</div><div class="actions"><button class="btn icon" onclick="edit('+i+')">Düzenle</button><button class="btn icon danger" onclick="del('+i+')">Sil</button></div></article>'}).join(''):'<div class="empty">Eşleşen snippet yok.</div>'}
function esc(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}
function openNew(){editing=null;title.textContent='Yeni snippet';trigger.value=':';replace.value='';modal.showModal();trigger.focus()}
function edit(i){editing=i;title.textContent='Snippet düzenle';trigger.value=items[i].trigger;replace.value=items[i].replace;modal.showModal();trigger.focus()}
async function save(e){e.preventDefault();const body={trigger:trigger.value.trim(),replace:replace.value};const method=editing===null?'POST':'PUT';if(editing!==null)body.index=editing;const r=await fetch('/api/snippets',{method,headers:{'Content-Type':'application/json','X-Token':'__TOKEN__'},body:JSON.stringify(body)});if(!r.ok){alert(await r.text());return}modal.close();await load()}
async function del(i){if(!confirm(items[i].trigger+' silinsin mi?'))return;const r=await fetch('/api/snippets',{method:'DELETE',headers:{'Content-Type':'application/json','X-Token':'__TOKEN__'},body:JSON.stringify({index:i})});if(!r.ok){alert(await r.text());return}await load()}
load();
</script></body></html>'''

class Handler(BaseHTTPRequestHandler):
    def send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body.encode()
        self.send_response(code); self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control","no-store"); self.end_headers(); self.wfile.write(data)
    def do_GET(self):
        p=urlparse(self.path).path
        if p=="/": self.send(200, PAGE.replace("__TOKEN__",TOKEN), "text/html; charset=utf-8")
        elif p=="/api/snippets": self.send(200,json.dumps(parse_matches(),ensure_ascii=False))
        else: self.send(404,"not found","text/plain")
    def mutate(self, method):
        if self.headers.get("X-Token") != TOKEN: return self.send(403,"forbidden","text/plain")
        try:
            n=int(self.headers.get("Content-Length","0")); data=json.loads(self.rfile.read(n)); items=parse_matches()
            if method=="POST":
                if not data.get("trigger","").strip() or not data.get("replace",""): raise ValueError("Trigger ve çıktı gerekli.")
                if any(x["trigger"]==data["trigger"].strip() for x in items): raise ValueError("Bu trigger zaten var.")
                items.append({"trigger":data["trigger"].strip(),"replace":data["replace"]})
            elif method=="PUT":
                i=int(data["index"]); t=data.get("trigger","").strip()
                if not t or not data.get("replace",""): raise ValueError("Trigger ve çıktı gerekli.")
                if any(j!=i and x["trigger"]==t for j,x in enumerate(items)): raise ValueError("Bu trigger zaten var.")
                items[i]={"trigger":t,"replace":data["replace"]}
            else: items.pop(int(data["index"]))
            write_matches(items); self.send(200,'{"ok":true}')
        except (ValueError,KeyError,IndexError,json.JSONDecodeError) as e: self.send(400,str(e),"text/plain")
    def do_POST(self): self.mutate("POST")
    def do_PUT(self): self.mutate("PUT")
    def do_DELETE(self): self.mutate("DELETE")
    def log_message(self, fmt, *args): pass

if __name__=="__main__":
    server=ThreadingHTTPServer((HOST,PORT),Handler)
    threading.Timer(.25, lambda:webbrowser.open(f"http://{HOST}:{PORT}")).start()
    try: server.serve_forever()
    except KeyboardInterrupt: pass
