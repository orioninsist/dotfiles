#!/usr/bin/env bash
set -euo pipefail

repo="/mnt/local/projects/knowledge"
build_binary="$repo/src-tauri/target/release/knowledge-productivity"
install_dir="$HOME/.local/libexec"
binary="$install_dir/knowledge-productivity"
stamp="$install_dir/.knowledge-productivity-source"

mkdir -p "$install_dir" "$HOME/.local/state"
cd "$repo"

# Only files that affect the desktop shell invalidate the installed binary.
source_id="$(
    {
        git rev-parse HEAD:src-tauri
        git rev-parse HEAD:static/productivity
        git rev-parse HEAD:package.json
    } | sha256sum | cut -d' ' -f1
)"
built=""
[[ -f "$stamp" ]] && built="$(cat "$stamp")"

build_and_install() {
    bun run productivity:build
    install -m 755 "$build_binary" "$binary.new"
    mv -f "$binary.new" "$binary"
    printf '%s\n' "$source_id" > "$stamp"
}

if [[ ! -x "$binary" ]]; then
    # One-time bootstrap. Later target/ cleanups do not remove the installed app.
    build_and_install
elif [[ "$built" != "$source_id" ]]; then
    # Never make F8 wait for a rebuild when a working desktop binary exists.
    # Refresh it in the background for the next app start.
    (
        build_and_install
    ) >"$HOME/.local/state/knowledge-productivity-build.log" 2>&1 &
fi

exec "$binary"
