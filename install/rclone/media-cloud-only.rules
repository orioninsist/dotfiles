# ============================================================
# ORION MEDIA CLOUD-ONLY RULES
#
# Bu dosya SADECE:
#
#   Drive'a basariyla yedeklendikten sonra
#   yerelden kaldirilmasina izin verilen dosyalari
#
# tanimlar.
#
# ------------------------------------------------------------
#
# NORMAL DOSYA:
#
#   Local  -> VAR
#   Drive  -> VAR
#
#
# CLOUD-ONLY DOSYA:
#
#   once:
#       Local -> VAR
#       Drive -> COPY
#
#   backup dogrulandiktan sonra:
#       Local -> SIL
#       Drive -> KALSIN
#
# ------------------------------------------------------------
#
# ONEMLI:
#
# Bu dosyada AKTIF kural yoksa
# yerelden HICBIR DOSYA silinmez.
#
# Asagidaki orneklerin hepsi '#' ile basladigi icin PASIFTIR.
#
# ============================================================


# ------------------------------------------------------------
# ORNEK 1
# 1-Image altindaki ISO dosyalari cloud-only
# ------------------------------------------------------------

# /1-Image/**/*.iso


# ------------------------------------------------------------
# ORNEK 2
# Media'nin herhangi bir yerindeki ZIP dosyalari
# ------------------------------------------------------------

# **/*.zip


# ------------------------------------------------------------
# ORNEK 3
# Bir klasorun tum DOSYALARI cloud-only
# ------------------------------------------------------------

# /2-Video/archive/**


# ------------------------------------------------------------
# ORNEK 4
# Tek bir dosya cloud-only
# ------------------------------------------------------------

# /2-Video/example.mkv


# ------------------------------------------------------------
# ORNEK 5
# Belirli proje icindeki buyuk arsivler
# ------------------------------------------------------------

# /6-Project/example/archive/**/*.tar.zst


# ============================================================
# AKTIF CLOUD-ONLY KURALLAR
# ============================================================
#
# Kendi kurallarini bu satirin ALTINA yaz.
#
# SU ANDA AKTIF KURAL YOK.
#
# ============================================================
