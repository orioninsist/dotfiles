# Upstream reference:
# https://github.com/github/gitignore
#
# These templates are REFERENCES for reproducible/generated development
# exclusions. They are NOT passed directly to rclone because Git ignore
# semantics and backup semantics are different.
#
# Only reproducible dependency/build/cache artifacts are excluded.
# Secrets, databases, local data and user content are intentionally NOT
# automatically excluded.

