#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "===== SYSTEM APPLY ====="


echo
echo "===== DNF APPLY ====="

PACKAGE_FILE="$ROOT_DIR/dnf/state/packages.txt"

if [ -f "$PACKAGE_FILE" ]; then

    mapfile -t PACKAGES < <(
        grep -v '^#' "$PACKAGE_FILE" |
        grep -v '^$'
    )

    if [ "${#PACKAGES[@]}" -gt 0 ]; then
        echo "Installing ${#PACKAGES[@]} packages"
        sudo dnf install -y "${PACKAGES[@]}"
    fi

else
    echo "DNF state missing"
fi


echo


echo
echo "===== SYSTEMD APPLY ====="

SYSTEMD_FILE="$ROOT_DIR/systemd/state/enabled.txt"

if [ -f "$SYSTEMD_FILE" ]; then

    while read -r service; do

        [ -z "$service" ] && continue

        echo "Enable: $service"

        sudo systemctl enable "$service" 2>/dev/null || true

    done < "$SYSTEMD_FILE"

fi


echo
echo "===== APPLY COMPLETE ====="
