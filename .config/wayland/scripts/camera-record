#!/usr/bin/env bash

set -euo pipefail

export LD_LIBRARY_PATH=/usr/lib

RECORD_DIR="$HOME/.record"
PID_FILE="$HOME/.cache/camera-record.pid"
LOG_FILE="$HOME/.cache/camera-record.log"

RECORDING_LOCK="$HOME/.config/wayland/scripts/recording-lock"

CAMERA="${CAMERA_DEVICE:-/dev/video0}"
MIC="${MIC_SOURCE:-$(pactl get-default-source 2>/dev/null || true)}"
SPEAKER="${SPEAKER_SOURCE:-$(pactl get-default-sink 2>/dev/null || true).monitor}"

mkdir -p "$RECORD_DIR" "$HOME/.cache"

command -v ffmpeg >/dev/null 2>&1 || { notify-send "Camera Recording" "ffmpeg is not installed"; exit 1; }
[[ -e "$CAMERA" ]] || { notify-send "Camera Recording" "Camera device not found: $CAMERA"; exit 1; }
[[ -n "$MIC" ]] || { notify-send "Camera Recording" "No microphone source found"; exit 1; }

# Toggle: stop the currently active camera recording.
if [[ -f "$PID_FILE" ]]; then
    PID="$(cat "$PID_FILE")"

    if kill -0 "$PID" 2>/dev/null; then
        kill -INT "$PID"
        notify-send "Camera Recording" "Stopping recording"
        exit 0
    fi

    rm -f "$PID_FILE"
fi

# Prevent overlapping recording sessions.
"$RECORDING_LOCK" acquire camera || exit 1
trap '"$RECORDING_LOCK" release camera' EXIT

TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
OUTPUT_FILE="$RECORD_DIR/camera_${TIMESTAMP}.mp4"

ffmpeg \
    -hide_banner \
    -loglevel warning \
    -f v4l2 \
    -i "$CAMERA" \
    -f pulse \
    -i "$MIC" \
    -map 0:v \
    -map 1:a \
    -c:v libx264 \
    -c:a aac \
    "$OUTPUT_FILE" >"$LOG_FILE" 2>&1 &

PID=$!
echo "$PID" > "$PID_FILE"

notify-send "Camera Recording" "Recording started"

sleep 1
if ! kill -0 "$PID" 2>/dev/null; then
    rm -f "$PID_FILE"
    notify-send "Camera Recording" "Failed to start. See $LOG_FILE"
    exit 1
fi

STATUS=0
wait "$PID" || STATUS=$?

rm -f "$PID_FILE"

if [[ -s "$OUTPUT_FILE" ]]; then
    notify-send "Camera Recording" "Recording finished: $OUTPUT_FILE"
elif (( STATUS != 0 )); then
    notify-send "Camera Recording" "Recording failed. See $LOG_FILE"
    exit 1
else
    notify-send "Camera Recording" "Recording produced no file"
    exit 1
fi
