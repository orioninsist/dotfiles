#!/usr/bin/env bash

set -euo pipefail

declare -A seen=()
commands=()

IFS=':' read -ra path_dirs <<< "$PATH"

for dir in "${path_dirs[@]}"; do
    [[ -d "$dir" ]] || continue

    while IFS= read -r -d '' executable; do
        [[ -f "$executable" && -x "$executable" ]] || continue

        command="${executable##*/}"
        [[ -n "${seen[$command]+x}" ]] && continue

        seen["$command"]=1
        commands+=("$command")
    done < <(find -L "$dir" -maxdepth 1 -type f -perm -u+x -print0 2>/dev/null)
done

(("${#commands[@]}" > 0)) || exit 0

selection="$(
    printf '%s\n' "${commands[@]}" |
        sort -fu |
        fzf --prompt='Run > '
)" || exit 0

[[ -n "$selection" ]] || exit 0

# fzf is the foreground process of the popup terminal.  Replacing this
# shell with the selected command lets Foot keep the client alive instead of
# tearing down a newly-detached GUI process together with the picker.
exec "$selection"
