#!/usr/bin/env bash

choice="$(
    printf '%s\n' \
        'Media Backup — Status' \
        'Media Backup — Live Log' \
        'Timers — Orion' \
        'Failed User Services' \
        'Mako — Status' \
        'Rclone Google Drive — Status' \
        'System State Sync — Status' |
        fuzzel --dmenu --prompt='System Status > '
)"

[[ -n "$choice" ]] || exit 0

open_terminal() {
    kitty --title "System Status" bash -lc "$1; printf '\n'; read -rp 'Press Enter to close...'"
}

case "$choice" in
    'Media Backup — Status')
        open_terminal \
            'systemctl --user status orion-media-backup.service --no-pager'
        ;;

    'Media Backup — Live Log')
        kitty --title "Media Backup — Live Log" \
            bash -lc \
            'echo "Ctrl+C = stop live view"; echo; journalctl --user -fu orion-media-backup.service'
        ;;

    'Timers — Orion')
        open_terminal \
            'systemctl --user list-timers --all --no-pager | grep -E "NEXT|orion-"'
        ;;

    'Failed User Services')
        open_terminal \
            'systemctl --user --failed --no-pager'
        ;;

    'Mako — Status')
        open_terminal \
            'systemctl --user status mako.service --no-pager; echo; echo "PROCESS:"; pgrep -a mako || true'
        ;;

    'Rclone Google Drive — Status')
        open_terminal \
            'systemctl --user status rclone-gdrive.service rclone-gdrive-shared.service --no-pager; echo; echo "PROCESSES:"; pgrep -a -f "rclone mount" || true'
        ;;

    'System State Sync — Status')
        open_terminal \
            'systemctl --user status orion-system-state-sync.service --no-pager; echo; echo "TIMER:"; systemctl --user list-timers --all --no-pager | grep -E "NEXT|orion-system-state-sync"'
        ;;
esac
