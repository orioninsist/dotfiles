#!/usr/bin/env bash

STATE="$HOME/.cache/camera-state"
USB_DEVICE="/sys/bus/usb/devices/1-6/authorized"

if [[ "$(cat "$USB_DEVICE")" == "1" ]]; then
    run0 sh -c 'printf "0\n" > "$1"' sh "$USB_DEVICE"
    echo "off" > "$STATE"
    notify-send "Camera" "Camera OFF"
else
    run0 sh -c 'printf "1\n" > "$1"' sh "$USB_DEVICE"
    echo "on" > "$STATE"
    notify-send "Camera" "Camera ON"
fi

pkill -RTMIN+8 waybar 2>/dev/null || true
