#!/usr/bin/env bash

set -euo pipefail

emoji_data="$HOME/.config/wayland/scripts/emoji-test.txt"
log_file="$HOME/.cache/orion-clipboard.log"
printf 'emoji-picker started\n' >> "$log_file"

[[ -r "$emoji_data" ]] || exit 1

selection="$(
    awk '
        /; fully-qualified[[:space:]]*#/ {
            split($0, parts, "# ")
            entry = parts[2]
            sub(/ E[0-9.]+ /, "\t", entry)
            print entry
        }
    ' "$emoji_data" |
        fzf --prompt="emoji > "
)" || exit 0

printf 'emoji selection: %q\n' "$selection" >> "$log_file"

[[ -n "$selection" ]] || exit 0

emoji="${selection%%$'\t'*}"

[[ -n "$emoji" ]] || exit 0

printf 'emoji value: %q\n' "$emoji" >> "$log_file"

"$HOME/.config/wayland/scripts/clipboard-copy" "$emoji"
