#!/usr/bin/env bash

set -euo pipefail

text="${1-}"
[[ -n "$text" ]] || exit 2

runtime_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}"
mkdir -p "$runtime_dir"
payload="$runtime_dir/orion-clipboard.txt"
printf '%s' "$text" > "$payload"

# A new wl-copy owner replaces the previous Wayland clipboard owner itself.
# Do not pkill old owners here: on some sessions that command can block.
nohup wl-copy --paste-once < "$payload" >/dev/null 2>&1 &
