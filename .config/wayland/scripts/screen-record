#!/usr/bin/env bash
set -euo pipefail

RECORD_DIR="$HOME/.record"
PID_FILE="$HOME/.cache/screen-record.pid"
RECORDING_LOCK="$HOME/.config/wayland/scripts/recording-lock"

mkdir -p "$RECORD_DIR" "$HOME/.cache"

command -v wl-screenrec >/dev/null 2>&1 || {
  notify-send "Screen Recording" "wl-screenrec is not installed"
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  notify-send "Screen Recording" "jq is not installed"
  exit 1
}

list_outputs() {
    niri msg --json outputs 2>/dev/null |
        jq -r 'keys[]?' 2>/dev/null
}

first_output() {
    list_outputs | sed -n '1p'
}

second_output() {
    list_outputs | sed -n '2p'
}

if [[ -f "$PID_FILE" ]]; then
    PID="$(cat "$PID_FILE")"
    if kill -0 "$PID" 2>/dev/null; then
        kill -INT "$PID"
        notify-send "Screen Recording" "Stopping recording"
        exit 0
    fi
    rm -f "$PID_FILE"
fi

MODE="${1:-}"
case "$MODE" in
    1) OUTPUT="${SCREEN_RECORD_OUTPUT_1:-$(first_output)}"; PREFIX="screen1" ;;
    2) OUTPUT="${SCREEN_RECORD_OUTPUT_2:-$(second_output)}"; PREFIX="screen2" ;;
    3) OUTPUT=""; PREFIX="area" ;;
    *) notify-send "Screen Recording" "Invalid recording mode"; exit 1 ;;
esac

if [[ "$MODE" != "3" && -z "$OUTPUT" ]]; then
    notify-send "Screen Recording" "No output found for mode $MODE"
    exit 1
fi

"$RECORDING_LOCK" acquire screen || exit 1
trap '"$RECORDING_LOCK" release screen' EXIT

if [[ "$MODE" == "3" ]]; then
    GEOMETRY="$(slurp)" || exit 0
fi

TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
OUTPUT_FILE="$RECORD_DIR/${PREFIX}_${TIMESTAMP}.mp4"

ARGS=(--filename "$OUTPUT_FILE" --codec avc --low-power off)

if pactl info >/dev/null 2>&1; then
    DEFAULT_SOURCE="$(pactl get-default-source 2>/dev/null || true)"
    if [[ -n "$DEFAULT_SOURCE" ]]; then
        ARGS+=(--audio --audio-device "$DEFAULT_SOURCE" --audio-backend pulse)
    fi
fi

if [[ "$MODE" == "3" ]]; then
    ARGS+=(--geometry "$GEOMETRY")
else
    ARGS+=(--output "$OUTPUT")
fi

wl-screenrec "${ARGS[@]}" &
PID=$!
echo "$PID" > "$PID_FILE"
notify-send "Screen Recording" "Recording started"
wait "$PID" || true
rm -f "$PID_FILE"
notify-send "Screen Recording" "Recording finished: $OUTPUT_FILE"
