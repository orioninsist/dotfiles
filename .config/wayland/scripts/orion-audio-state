#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/orion-status"
state_file="$state_dir/microphone"
mkdir -p "$state_dir"

write_state() {
    local value tmp
    value="$(/usr/bin/wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
    [[ -n "$value" ]] || return 0
    if [[ "$value" == *"[MUTED]"* ]]; then
        value="muted"
    else
        value="on"
    fi
    tmp="${state_file}.tmp"
    printf '%s\n' "$value" > "$tmp"
    mv "$tmp" "$state_file"
}

write_state

# pw-mon blocks on PipeWire events; no interval polling.
/usr/bin/pw-mon 2>/dev/null |
while IFS= read -r _; do
    write_state
done
