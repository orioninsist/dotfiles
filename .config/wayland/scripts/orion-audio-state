#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/orion-status"
state_file="$state_dir/microphone"
mkdir -p "$state_dir"

WPCTL="$(command -v wpctl || true)"
PACTL="$(command -v pactl || true)"
[[ -n "$WPCTL" && -n "$PACTL" ]] || exit 127

write_state() {
    local raw value current tmp
    raw="$("$WPCTL" get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
    [[ -n "$raw" ]] || return 0

    if [[ "$raw" == *"[MUTED]"* ]]; then
        value="muted"
    else
        value="on"
    fi

    current="$(cat "$state_file" 2>/dev/null || true)"
    [[ "$current" == "$value" ]] && return 0

    tmp="${state_file}.tmp"
    printf '%s\n' "$value" > "$tmp"
    mv "$tmp" "$state_file"
}

write_state

# pipewire-pulse emits one subscription line per object event. React only to
# source/server changes instead of parsing pw-mon's multi-line graph dump.
"$PACTL" subscribe |
while IFS= read -r event; do
    case "$event" in
        *" on source "*|*" on server")
            write_state
            ;;
    esac
done
