#!/usr/bin/env bash

set -euo pipefail

selection="$(
    makoctl history -j |
        jq -r '
            .[:5][] |
            [
                (.app_name // "notification"),
                (.summary // ""),
                ((.body // "") | gsub("\n"; " "))
            ] |
            @tsv
        ' |
        awk -F '\t' '{
            text = "[" $1 "] " $2
            if ($3 != "") text = text " — " $3
            print text
        }' |
        fzf --prompt="Notifications > " --height=40% --reverse
)" || exit 0

[[ -n "$selection" ]] || exit 0

nohup sh -c 'printf %s "$1" | wl-copy --foreground' _ "$selection" >/dev/null 2>&1 &
