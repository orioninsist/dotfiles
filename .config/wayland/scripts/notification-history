#!/usr/bin/env bash

set -euo pipefail

selection="$(
    makoctl history -j |
        jq -r '.[] | "\(.id)\t[\(.app_name)] \(.summary) — \(.body | gsub("\n"; " "))"' |
        fuzzel --dmenu --prompt="Notifications > " --width=70 --lines=10
)"

[[ -n "$selection" ]] || exit 0

printf '%s\n' "$selection" | wl-copy
