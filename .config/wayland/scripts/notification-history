#!/usr/bin/env bash

set -euo pipefail
log_file="$HOME/.cache/orion-clipboard.log"
printf 'notification-picker started\n' >> "$log_file"

selection="$(
    makoctl history -j |
        jq -r '
            .[:5][] |
            [
                (.app_name // "notification"),
                (.summary // ""),
                ((.body // "") | gsub("\n"; " "))
            ] |
            @tsv
        ' |
        awk -F '\t' '{
            text = "[" $1 "] " $2
            if ($3 != "") text = text " — " $3
            print text
        }' |
        fzf --prompt="Notifications > " --height=40% --reverse
)" || exit 0

printf 'notification selection: %q\n' "$selection" >> "$log_file"
printf '%s\n' "$selection" > "${XDG_RUNTIME_DIR:-$HOME/.cache}/orion-picker-result"

[[ -n "$selection" ]] || exit 0

"$HOME/.config/wayland/scripts/clipboard-copy" "$selection"
