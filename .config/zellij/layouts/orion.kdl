layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="file:$HOME/.config/zellij/plugins/orion-status/dist/orion-status.wasm" {
                home "/home/murat"
            }
        }
    }
    tab
}
