themes {
    orion_dark {
        // Catppuccin Mocha, tuned for long-session readability.
        // Zellij status-bar uses fg as the large key-cap background, so using
        // Mocha Text here creates bright near-white blocks. Overlay2 keeps the
        // bar readable without glare while remaining inside the Mocha palette.
        bg "#313244"       // Surface0
        fg "#9399b2"       // Overlay2

        black "#181825"    // Mantle
        red "#7f849c"      // Overlay1 - calm key-hint accent
        green "#a6e3a1"
        yellow "#f9e2af"
        blue "#89b4fa"
        magenta "#b4befe"  // Lavender
        cyan "#89dceb"     // Sky
        white "#bac2de"    // Subtext1
        orange "#fab387"   // Peach
    }
}
