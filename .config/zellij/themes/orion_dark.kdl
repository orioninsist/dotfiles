themes {
    orion_dark {
        // Catppuccin Mocha, optimized for a uniform low-glare Zellij bar.
        // Make every key-cap read like the calm "Ctrl +" segment:
        // dark surfaces, muted separators, and soft light text.
        bg "#1e1e2e"       // Base
        fg "#45475a"       // Surface1

        black "#181825"    // Mantle
        red "#45475a"      // Surface1
        green "#45475a"    // Surface1
        yellow "#45475a"   // Surface1
        blue "#45475a"     // Surface1
        magenta "#45475a"  // Surface1
        cyan "#45475a"     // Surface1
        white "#bac2de"    // Subtext1
        orange "#45475a"   // Surface1
    }
}
