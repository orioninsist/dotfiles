themes {
    orion_dark {
        // Catppuccin Mocha with a restrained, low-glare Zellij UI.
        // Keep the whole status bar visually quiet: one dark base, muted key caps,
        // and only a few semantic accents.
        bg "#1e1e2e"       // Base
        fg "#7f849c"       // Overlay1

        black "#181825"    // Mantle
        red "#7f849c"      // Overlay1
        green "#a6e3a1"    // Green
        yellow "#f9e2af"   // Yellow
        blue "#89b4fa"     // Blue
        magenta "#b4befe"  // Lavender
        cyan "#89dceb"     // Sky
        white "#bac2de"    // Subtext1
        orange "#fab387"   // Peach
    }
}
