font=monospace 10

# Catppuccin Mocha
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
border-size=1
border-radius=8
padding=10
margin=12

width=360
height=120

anchor=top-right

default-timeout=5000
max-visible=4

icons=1
max-icon-size=32

[urgency=low]
default-timeout=3000
border-color=#6c7086

[urgency=normal]
default-timeout=5000
border-color=#89b4fa

[urgency=critical]
default-timeout=0
border-color=#f38ba8

[mode=do-not-disturb]
invisible=1
