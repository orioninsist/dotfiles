font=monospace 10

background-color=#111111
text-color=#d8d8d8
border-color=#666666
border-size=1
border-radius=8
padding=10
margin=12

width=360
height=120

anchor=top-right

default-timeout=5000
max-visible=4

icons=1
max-icon-size=32

[urgency=low]
default-timeout=3000
border-color=#444444

[urgency=normal]
default-timeout=5000
border-color=#666666

[urgency=critical]
default-timeout=0
border-color=#ff5555

[mode=do-not-disturb]
invisible=1
