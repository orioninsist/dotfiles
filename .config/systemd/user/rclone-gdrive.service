[Unit]
Description=Read-only Google Drive mount
Documentation=https://rclone.org/drive/
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
  --config %h/.config/rclone/rclone.conf \
  --read-only \
  --vfs-cache-mode off \
  --dir-cache-time 5m \
  --poll-interval 1m
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
