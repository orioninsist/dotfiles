[Unit]
Description=Knowledge Personal Search API
ConditionPathIsDirectory=/mnt/local/projects/knowledge

[Service]
Type=simple
WorkingDirectory=/mnt/local/projects/knowledge
Environment=KNOWLEDGE_API_PORT=8788
Environment=KNOWLEDGE_DB_PATH=/mnt/local/projects/knowledge/.runtime/personal/knowledge.db
Environment=KNOWLEDGE_D2_BIN=/usr/bin/d2
Environment=KNOWLEDGE_TYPST_BIN=%h/.local/bin/typst
ExecStart=%h/.bun/bin/bun scripts/search-server.ts
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
