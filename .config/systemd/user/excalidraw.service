[Unit]
Description=Excalidraw Local Server
After=network.target
ConditionPathIsDirectory=%h/Projects/excalidraw

[Service]
WorkingDirectory=%h/Projects/excalidraw
ExecStart=/usr/bin/env yarn workspace excalidraw-app start --host 127.0.0.1 --port 3001
Restart=always
RestartSec=5
Environment=NODE_ENV=development

[Install]
WantedBy=default.target
