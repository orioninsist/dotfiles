[Unit]
Description=EasyEffects audio effects service
After=graphical-session.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'for _ in $(seq 1 30); do pactl list short sinks 2>/dev/null | cut -f2 | grep -Eq "^alsa_output\\." && exit 0; sleep 1; done; echo "No physical audio sink available" >&2; exit 1'
ExecStart=/usr/local/bin/easyeffects --service-mode --hide-window --load-preset Laptop-Speakers
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
