// Personal application launchers.
// Kept separate from Niri-native window management.
binds {
    Mod+Return { spawn "/usr/local/bin/foot"; }
    Mod+D { spawn "fuzzel"; }
    Mod+C { spawn "bash" "/home/murat/.config/wayland/scripts/espanso-search"; }
    Mod+Ctrl+Return { spawn "alacritty"; }
    Mod+Y { spawn "/usr/local/bin/kitty" "/home/murat/.local/bin/yazi"; }

    Mod+Ctrl+B { spawn "google-chrome-stable"; }
    Mod+Ctrl+Shift+B { spawn "brave"; }
    Mod+Ctrl+M { spawn "microsoft-edge-stable"; }
    Mod+Ctrl+Shift+Y { spawn "yandex-browser-stable"; }
    Mod+Ctrl+F { spawn "firefox"; }
    Mod+Ctrl+Shift+F { spawn "firefox-developer-edition"; }
    Mod+Ctrl+T { spawn "tor-browser"; }
    Mod+Ctrl+Shift+M { spawn "mullvad-browser"; }
    Mod+Ctrl+Y { spawn "nautilus" "--new-window"; }

    Mod+F8 { spawn-sh "niri msg action focus-workspace 7; /opt/google/chrome/google-chrome --profile-directory=Default --app-id=idkejijbjcgdnloelolopdemkebfadai"; }
    Mod+F11 { spawn "/usr/bin/snapshot"; }
    Mod+P { spawn "/usr/bin/flameshot" "gui"; }
}
