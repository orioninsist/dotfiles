// Session, hardware, capture and compositor-independent utilities.
binds {
    Mod+Ctrl+Space { switch-layout "next"; }

    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioStop allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }

    Mod+F1 { spawn-sh "busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s performance && notify-send 'Power Profile' 'Performance mode enabled'"; }
    Mod+F2 { spawn-sh "busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s balanced && notify-send 'Power Profile' 'Balanced mode enabled'"; }
    Mod+F3 { spawn-sh "busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s power-saver && notify-send 'Power Profile' 'Battery saving mode enabled'"; }

    Mod+T { spawn "bash" "/home/murat/.config/wayland/scripts/bluetooth-toggle"; }
    Mod+F4 { spawn "bash" "/home/murat/.config/wayland/scripts/audio-toggle"; }
    Mod+F5 { spawn "bash" "/home/murat/.config/wayland/scripts/mic-toggle"; }
    Mod+F6 { spawn "bash" "/home/murat/.config/wayland/scripts/camera-toggle"; }

    Mod+Shift+A { spawn "bash" "/home/murat/.config/niri/scripts/display-mode" "asus"; }
    Mod+Shift+T { spawn "bash" "/home/murat/.config/niri/scripts/display-mode" "thinkpad"; }
    Mod+Shift+D { spawn "bash" "/home/murat/.config/niri/scripts/display-mode" "dual"; }

    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Mod+Ctrl+Print { screenshot-window; }

    Mod+Ctrl+1 { spawn "bash" "/home/murat/.config/wayland/scripts/screen-record" "1"; }
    Mod+Ctrl+2 { spawn "bash" "/home/murat/.config/wayland/scripts/screen-record" "2"; }
    Mod+Ctrl+3 { spawn "bash" "/home/murat/.config/wayland/scripts/screen-record" "3"; }
    Mod+Ctrl+4 { spawn "bash" "/home/murat/.config/wayland/scripts/camera-record"; }
    Mod+Ctrl+5 { spawn "bash" "/home/murat/.config/wayland/scripts/screen-camera-record"; }
    Mod+Ctrl+Shift+Print { spawn "bash" "/home/murat/.config/wayland/scripts/ocr"; }

    Mod+I { spawn "/home/murat/.local/bin/whisper-type.sh"; }
    Mod+Shift+I { spawn "/home/murat/.local/bin/whisper-type.sh" "en"; }
    Mod+Ctrl+P { spawn "/usr/bin/wl-color-picker"; }

    Mod+Shift+V { spawn "bash" "/home/murat/.config/wayland/scripts/clipboard-history"; }
    Mod+C { spawn "bash" "/home/murat/.config/wayland/scripts/waybar-visibility"; }
    Mod+N { spawn "bash" "/home/murat/.config/wayland/scripts/mako-toggle"; }
    Mod+Shift+N { spawn "bash" "/home/murat/.config/wayland/scripts/wlsunset-toggle"; }
    Mod+Ctrl+N { spawn "bash" "/home/murat/.config/wayland/scripts/notification-history"; }
    Mod+Ctrl+E { spawn "bash" "/home/murat/.config/wayland/scripts/emoji-picker"; }

    Mod+Shift+C { spawn-sh "niri msg action load-config-file"; }
    Mod+F11 { spawn "/usr/local/bin/foot" "/usr/local/bin/glow" "-p" "/home/murat/.config/niri/README.md"; }

    Mod+Shift+S { spawn-sh "/usr/local/bin/swaylock -f -c 000000 && systemctl suspend"; }
    Mod+Shift+Escape { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}
