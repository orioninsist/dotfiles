// Niri configuration
// Managed by: /mnt/local/projects/dotfiles

input {
    keyboard {
        xkb {
            layout "us,tr"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    // Match Sway's keyboard-focused behavior.
    // focus-follows-mouse intentionally remains disabled.
    warp-mouse-to-focus
}

output "eDP-1" {
    scale 1
    transform "normal"
}

output "HDMI-A-1" {
    scale 1
    transform "normal"
}

layout {
    gaps 3
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 3
        active-color "#89b4fa"
        inactive-color "#181825"
        urgent-color "#f38ba8"
    }
}

// Persistent named workspaces.
// 1-5 prefer the external ASUS display.
// 6-10 prefer the ThinkPad display.
workspace "1" { open-on-output "HDMI-A-1"; }
workspace "2" { open-on-output "HDMI-A-1"; }
workspace "3" { open-on-output "HDMI-A-1"; }
workspace "4" { open-on-output "HDMI-A-1"; }
workspace "5" { open-on-output "HDMI-A-1"; }

workspace "6"  { open-on-output "eDP-1"; }
workspace "7"  { open-on-output "eDP-1"; }
workspace "8"  { open-on-output "eDP-1"; }
workspace "9"  { open-on-output "eDP-1"; }
workspace "10" { open-on-output "eDP-1"; }

// Session applications.
spawn-sh-at-startup "pkill -x waybar 2>/dev/null || true; exec waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/style.css"
spawn-at-startup "/usr/local/bin/mako"
spawn-at-startup "systemctl" "--user" "start" "cliphist.service"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "monospace-font-name" "Google Sans Code 10"

// Wallpaper. swaybg is compositor-independent.
spawn-at-startup "swaybg" "-i" "/home/murat/.wallpapers/sam-ferrara-uNvgvo2cs7k-unsplash.jpg" "-m" "fill"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

prefer-no-csd

// Workspace 1: web, communication, creative tools.
window-rule {
    match app-id=r#"^(google-chrome|chromium|firefox|firefox-developer-edition|microsoft-edge|yandex-browser|brave-browser|org\.gnome\.Nautilus|fr\.handbrake\.ghb|org\.inkscape\.Inkscape|gimp|org\.kde\.krita|wl-color-picker|org\.localsend\.localsend_app|signal|element)$"#
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"^chrome-(aghbiahbpaijignceidepookljebhfak|jbgdhngddinepfilfcmbcioimbgcolma|cadlkienfkclaiaibeoongdcgmdikeeg|mjoklplbddabcmpepnokjaffbmgbkkgg|pmcngklofgngifnoceehmchjlildnhkj|mpnpojknpmmopombnjdcgaaiekajbnjb|jkdlbdnmmndeckliookkkcbgindcjpme|mhpcpiccfiaoabcaedpafgjabjjheekk|eilembjdkfgodjkcjnpgpaenohkicgjd|kfgapjallbhpciobgmlhlhokknljkgho|kjfmejlnnfibknebffpdmphoiomckhdb|lbllnnflijadcmjbldbhljjoagkliklg|ncmjhecbjeaamljdfahankockkkdmedg|fhihpiojkbmbpdjeoajapmgkhlnakfjf|kefjledonklijopmnomlcbpllchaibag|okhfeehhillipaleckndoboggdkcebmo|cfkjhppcnjbkjoclfcjjkphpicbpoaeg|akpamiohjfcnimfljfndmaldlcfphjmp|hpfldicfbfomlpcikngkocigghgafkph|agimnkijcaahngcdmfeangaknmldooml|cinhimbnkkaeohfgghhklpknlkffjgod|ihogecoockfifohcaikgaegbgfpbkipa|cdbijngggjkalinmffpblfekjekjjadf)-Default$"#
    open-on-workspace "1"
}

// Workspace 2: terminals and device tools.
window-rule {
    match app-id=r#"^(kitty|Alacritty|foot|com\.gabm\.satty|scrcpy)$"#
    open-on-workspace "2"
}

// Workspace 3: development and virtualization.
window-rule {
    match app-id=r#"^(code|antigravity-ide|antigravity|dev\.zed\.Zed|github|jetbrains-studio|jetbrains-webstorm|jetbrains-pycharm|jetbrains-goland|jetbrains-clion|jetbrains-datagrip|jetbrains-dataspell|jetbrains-toolbox|virt-manager)$"#
    open-on-workspace "3"
}

// Workspace 4: productivity.
window-rule {
    match app-id=r#"^(chrome-idkejijbjcgdnloelolopdemkebfadai-Default|calibre-gui|TradingView)$"#
    open-on-workspace "4"
}

// Workspace 5: media.
window-rule {
    match app-id=r#"^(mpv|com\.obsproject\.Studio|io\.gitlab\.news_flash\.NewsFlash|folo)$"#
    open-on-workspace "5"
}

// XWayland applications.
// Verify their actual app-id values after the first Niri login with:
// niri msg windows

window-rule {
    match app-id=r#"^(Tor Browser|Mullvad Browser)$"#
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"^(Chatgpt|jetbrains-webstorm|jetbrains-pycharm|jetbrains-goland|jetbrains-clion|jetbrains-datagrip|jetbrains-dataspell|jetbrains-toolbox)$"#
    open-on-workspace "3"
}

window-rule {
    match app-id=r#"^Spotify$"#
    open-on-workspace "5"
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

binds {
    // Core
    Mod+Return { spawn "/usr/local/bin/foot"; }
    Mod+D { spawn "wmenu-run"; }
    Mod+Shift+Q repeat=false { close-window; }

    // US <-> TR keyboard layout.
    Mod+Ctrl+Space { switch-layout "next"; }

    // Focus: preserve Sway H/J/K/L model.
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Move windows/columns.
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // Niri-native scrolling/column controls.
    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+W { toggle-column-tabbed-display; }

    // Sway Mod+F was fullscreen. Preserve that muscle memory.
    Mod+F { fullscreen-window; }

    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space { switch-focus-between-floating-and-tiling; }

    // Workspaces.
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+0 { focus-workspace "10"; }

    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
    Mod+Shift+6 { move-column-to-workspace "6"; }
    Mod+Shift+7 { move-column-to-workspace "7"; }
    Mod+Shift+8 { move-column-to-workspace "8"; }
    Mod+Shift+9 { move-column-to-workspace "9"; }
    Mod+Shift+0 { move-column-to-workspace "10"; }

    Mod+Tab { focus-workspace-previous; }

    // Audio.
    XF86AudioMute allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-";
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+";
    }

    // Media.
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioStop allow-when-locked=true { spawn "playerctl" "stop"; }

    // Brightness.
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "set" "5%-";
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "set" "5%+";
    }

    // Power profiles.
    Mod+F1 {
        spawn-sh "busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s performance && notify-send 'Power Profile' 'Performance mode enabled'";
    }
    Mod+F2 {
        spawn-sh "busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s balanced && notify-send 'Power Profile' 'Balanced mode enabled'";
    }
    Mod+F3 {
        spawn-sh "busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s power-saver && notify-send 'Power Profile' 'Battery saving mode enabled'";
    }

    // Hardware helpers. These scripts do not depend on swaymsg.
    Mod+T { spawn "/home/murat/.config/sway/scripts/bluetooth/bluetooth-toggle"; }
    Mod+F4 { spawn "/home/murat/.config/sway/scripts/audio/audio-toggle"; }
    Mod+F5 { spawn "/home/murat/.config/sway/scripts/input/mic-toggle"; }
    Mod+F6 { spawn "/home/murat/.config/sway/scripts/input/camera-toggle"; }

    // Applications.
    Mod+Ctrl+Return { spawn "alacritty"; }
    Mod+Y { spawn "/usr/local/bin/kitty" "/home/murat/.local/bin/yazi"; }

    Mod+Ctrl+B { spawn "google-chrome-stable"; }
    Mod+Ctrl+Shift+B { spawn "brave"; }
    Mod+Ctrl+M { spawn "microsoft-edge-stable"; }
    Mod+Ctrl+Shift+Y { spawn "yandex-browser-stable"; }
    Mod+Ctrl+F { spawn "firefox"; }
    Mod+Ctrl+Shift+F { spawn "firefox-developer-edition"; }
    Mod+Ctrl+T { spawn "tor-browser"; }
    Mod+Ctrl+Shift+M { spawn "mullvad-browser"; }
    Mod+Ctrl+Y { spawn "nautilus"; }

    Mod+F10 { spawn "/usr/local/bin/snapshot"; }
    Mod+P { spawn "/usr/local/bin/flameshot" "gui"; }

    // Niri-native screenshots.
    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Mod+Ctrl+Print { screenshot-window; }

    // Existing recording tools are Wayland/wl-screenrec based and do not
    // depend on swaymsg.
    Mod+Ctrl+1 { spawn "/home/murat/.config/sway/scripts/sway-record" "1"; }
    Mod+Ctrl+2 { spawn "/home/murat/.config/sway/scripts/sway-record" "2"; }
    Mod+Ctrl+3 { spawn "/home/murat/.config/sway/scripts/sway-record" "3"; }
    Mod+Ctrl+4 { spawn "/home/murat/.config/sway/scripts/sway-camera-record"; }
    Mod+Ctrl+5 { spawn "/home/murat/.config/sway/scripts/sway-screen-camera-record"; }

    // OCR uses slurp + grim and is compositor-independent.
    Mod+Ctrl+Shift+Print { spawn "/home/murat/.config/sway/scripts/sway-ocr"; }

    // Utilities known to be compositor-independent.
    Mod+I { spawn "/home/murat/.local/bin/whisper-type.sh"; }
    Mod+Shift+I { spawn "/home/murat/.local/bin/whisper-type.sh" "en"; }

    Mod+Ctrl+P { spawn "/usr/bin/wl-color-picker"; }

    // Waybar / notifications.
    Mod+C { spawn "/home/murat/.config/sway/scripts/waybar-visibility"; }
    Mod+N { spawn "/home/murat/.config/sway/scripts/mako-toggle"; }
    Mod+Ctrl+N { spawn "/home/murat/.config/sway/scripts/notification-history"; }
    Mod+Ctrl+E { spawn "/home/murat/.config/sway/scripts/emoji-picker"; }

    // Lock + suspend.
    Mod+Shift+S {
        spawn-sh "/usr/local/bin/swaylock -f -c 000000 && systemctl suspend";
    }

    // Native Niri quit confirmation.
    Mod+Shift+Escape { quit; }
}
