// Niri configuration
// Managed by: /mnt/local/projects/dotfiles

input {
    keyboard {
        xkb {
            layout "us,tr"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    // Match Sway's keyboard-focused behavior.
    // focus-follows-mouse intentionally remains disabled.
    warp-mouse-to-focus
}

output "eDP-1" {
    scale 1
    transform "normal"
}

output "HDMI-A-1" {
    scale 1
    transform "normal"
}

layout {
    gaps 3
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 3
        active-color "#89b4fa"
        inactive-color "#181825"
        urgent-color "#f38ba8"
    }
}

// Persistent named workspaces.
// 1-5 prefer the external ASUS display.
// 6-10 prefer the ThinkPad display.
workspace "1" { open-on-output "HDMI-A-1"; }
workspace "2" { open-on-output "HDMI-A-1"; }
workspace "3" { open-on-output "HDMI-A-1"; }
workspace "4" { open-on-output "HDMI-A-1"; }
workspace "5" { open-on-output "HDMI-A-1"; }

workspace "6"  { open-on-output "eDP-1"; }
workspace "7"  { open-on-output "eDP-1"; }
workspace "8"  { open-on-output "eDP-1"; }
workspace "9"  { open-on-output "eDP-1"; }
workspace "10" { open-on-output "eDP-1"; }

// Session applications.
spawn-sh-at-startup "pkill -x waybar 2>/dev/null || true; exec waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/style.css"
spawn-at-startup "/usr/local/bin/mako"
spawn-at-startup "systemctl" "--user" "start" "cliphist.service"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "monospace-font-name" "Google Sans Code 10"

// Wallpaper. swaybg is compositor-independent.
spawn-at-startup "swaybg" "-i" "/home/murat/.wallpapers/sam-ferrara-uNvgvo2cs7k-unsplash.jpg" "-m" "fill"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

prefer-no-csd

// Workspace 1: web, communication, creative tools.
window-rule {
    match app-id=r#"^(google-chrome|chromium|firefox|firefox-developer-edition|microsoft-edge|yandex-browser|brave-browser|org\.gnome\.Nautilus|fr\.handbrake\.ghb|org\.inkscape\.Inkscape|gimp|org\.kde\.krita|wl-color-picker|org\.localsend\.localsend_app|signal|element)$"#
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"^chrome-(aghbiahbpaijignceidepookljebhfak|jbgdhngddinepfilfcmbcioimbgcolma|cadlkienfkclaiaibeoongdcgmdikeeg|mjoklplbddabcmpepnokjaffbmgbkkgg|pmcngklofgngifnoceehmchjlildnhkj|mpnpojknpmmopombnjdcgaaiekajbnjb|jkdlbdnmmndeckliookkkcbgindcjpme|mhpcpiccfiaoabcaedpafgjabjjheekk|eilembjdkfgodjkcjnpgpaenohkicgjd|kfgapjallbhpciobgmlhlhokknljkgho|kjfmejlnnfibknebffpdmphoiomckhdb|lbllnnflijadcmjbldbhljjoagkliklg|ncmjhecbjeaamljdfahankockkkdmedg|fhihpiojkbmbpdjeoajapmgkhlnakfjf|kefjledonklijopmnomlcbpllchaibag|okhfeehhillipaleckndoboggdkcebmo|cfkjhppcnjbkjoclfcjjkphpicbpoaeg|akpamiohjfcnimfljfndmaldlcfphjmp|hpfldicfbfomlpcikngkocigghgafkph|agimnkijcaahngcdmfeangaknmldooml|cinhimbnkkaeohfgghhklpknlkffjgod|ihogecoockfifohcaikgaegbgfpbkipa|cdbijngggjkalinmffpblfekjekjjadf)-Default$"#
    open-on-workspace "1"
}

// Workspace 2: terminals and device tools.
window-rule {
    match app-id=r#"^(kitty|Alacritty|foot|com\.gabm\.satty|scrcpy)$"#
    open-on-workspace "2"
}

// Workspace 3: development and virtualization.
window-rule {
    match app-id=r#"^(code|antigravity-ide|antigravity|dev\.zed\.Zed|github|jetbrains-studio|jetbrains-webstorm|jetbrains-pycharm|jetbrains-goland|jetbrains-clion|jetbrains-datagrip|jetbrains-dataspell|jetbrains-toolbox|virt-manager)$"#
    open-on-workspace "3"
}

// Workspace 4: productivity.
window-rule {
    match app-id=r#"^(chrome-idkejijbjcgdnloelolopdemkebfadai-Default|calibre-gui|TradingView)$"#
    open-on-workspace "4"
}

// Workspace 5: media.
window-rule {
    match app-id=r#"^(mpv|com\.obsproject\.Studio|io\.gitlab\.news_flash\.NewsFlash|folo)$"#
    open-on-workspace "5"
}

// XWayland applications.
// Verify their actual app-id values after the first Niri login with:
// niri msg windows

window-rule {
    match app-id=r#"^(Tor Browser|Mullvad Browser)$"#
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"^(Chatgpt|jetbrains-webstorm|jetbrains-pycharm|jetbrains-goland|jetbrains-clion|jetbrains-datagrip|jetbrains-dataspell|jetbrains-toolbox)$"#
    open-on-workspace "3"
}

window-rule {
    match app-id=r#"^Spotify$"#
    open-on-workspace "5"
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Modular bindings. Niri 26.04+ merges included binds sections.
include "binds/window-management.kdl"
include "binds/workspaces.kdl"
include "binds/system.kdl"
include "binds/applications.kdl"
