#!/usr/bin/env bash
set -euo pipefail

apps_file="${NIRI_APPS_FILE:-$HOME/.config/niri/apps.json}"
rules_file="${NIRI_APP_RULES_FILE:-$HOME/.config/niri/app-workspaces.kdl}"
tmp="${rules_file}.tmp"

command -v jq >/dev/null 2>&1 || exit 0
[[ -r "$apps_file" ]] || exit 0

{
    echo "// Generated from apps.json by sync-app-rules. Do not edit manually."
    while IFS=$'\t' read -r ws app; do
        [[ -n "$ws" && -n "$app" ]] || continue
        escaped="$(printf '%s' "$app" | sed 's/[.[\*^$()+?{|]/\\&/g')"
        cat <<EOF
window-rule {
    match app-id=r#"^${escaped}$"#
    open-on-workspace "$ws"
}

EOF
    done < <(jq -r '.workspaces[] as $w | $w.apps[] | [$w.id, .app_id] | @tsv' "$apps_file")
} > "$tmp"

mv "$tmp" "$rules_file"

if niri msg version >/dev/null 2>&1; then
    niri msg action load-config-file >/dev/null 2>&1 || true
fi
