#!/usr/bin/env bash
set -u

apps_file="${NIRI_APPS_FILE:-$HOME/.config/niri/apps.json}"
lock_dir="${XDG_RUNTIME_DIR:-/tmp}/niri-apps-order.lock"

command -v jq >/dev/null 2>&1 || exit 0
[[ -r "$apps_file" ]] || exit 0

apply_order() {
    mkdir "$lock_dir" 2>/dev/null || return 0
    trap 'rmdir "$lock_dir" 2>/dev/null || true' RETURN

    local windows workspaces focused
    windows="$(niri msg --json windows 2>/dev/null)" || return 0
    workspaces="$(niri msg --json workspaces 2>/dev/null)" || return 0
    focused="$(jq -r '.[] | select(.is_focused == true) | .id' <<<"$windows" | head -n1)"

    while IFS=$'\t' read -r ws app; do
        [[ -n "$ws" && -n "$app" ]] || continue
        local wsid id index
        wsid="$(jq -r --arg ws "$ws" '.[] | select(.name == $ws) | .id' <<<"$workspaces" | head -n1)"
        [[ -n "$wsid" && "$wsid" != "null" ]] || continue
        index="$(jq -r --argjson wid "$ws" --arg app "$app" '.workspaces[] | select(.id == $wid) | .apps | to_entries[] | select(.value.app_id == $app) | .key + 1' "$apps_file" | head -n1)"
        id="$(jq -r --arg app "$app" '[.[] | select(.app_id == $app)] | sort_by(.id) | .[0].id // empty' <<<"$windows")"
        [[ -n "$id" && -n "$index" ]] || continue
        niri msg action focus-window --id "$id" >/dev/null 2>&1 || continue

        current_wsid="$(jq -r --argjson id "$id" '.[] | select(.id == $id) | .workspace_id // empty' <<<"$windows")"
        if [[ "$current_wsid" != "$wsid" ]]; then
            niri msg action move-window-to-workspace "$ws" >/dev/null 2>&1 || continue
        fi
        niri msg action move-column-to-index "$index" >/dev/null 2>&1 || true
    done < <(jq -r '.workspaces[] as $w | $w.apps[] | [$w.id, .app_id] | @tsv' "$apps_file")

    [[ -n "$focused" ]] && niri msg action focus-window --id "$focused" >/dev/null 2>&1 || true
}

apply_order
niri msg --json event-stream 2>/dev/null |
while IFS= read -r event; do
    if jq -e '.WindowOpenedOrChanged // .WindowClosed' >/dev/null 2>&1 <<<"$event"; then
        sleep 0.12
        apply_order
    fi
done
