#!/usr/bin/env bash
set -u
command -v jq >/dev/null 2>&1 || exit 0
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/niri-window-place-once.lock"
flock -n 9 || exit 0
state_dir="${XDG_RUNTIME_DIR:-/tmp}/niri-place-once"
mkdir -p "$state_dir"
rm -f "$state_dir"/* 2>/dev/null || true

target_index() {
    case "$1" in
        # TAG 1: Web / Research / AI / Files
        google-chrome) echo 1 ;;
        chrome-cadlkienfkclaiaibeoongdcgmdikeeg-Default) echo 2 ;;
        chrome-mjoklplbddabcmpepnokjaffbmgbkkgg-Default) echo 3 ;;
        chrome-mhpcpiccfiaoabcaedpafgjabjjheekk-Default) echo 4 ;;
        chrome-hjopciijjmfioojmkkdhpmeobcmldadc-Default) echo 5 ;;
        chrome-ggjocahimgaohmigbfhghnlfcnjemagj-Default) echo 6 ;;
        chrome-kjfmejlnnfibknebffpdmphoiomckhdb-Default) echo 7 ;;
        chrome-aghbiahbpaijignceidepookljebhfak-Default) echo 8 ;;
        org.gnome.Nautilus) echo 9 ;;

        # TAG 2: Terminal / Operations
        foot) echo 1 ;;
        Alacritty) echo 2 ;;
        kitty) echo 3 ;;

        # TAG 3: Development
        code|code-url-handler) echo 1 ;;
        Chatgpt) echo 2 ;;
        github) echo 3 ;;
        antigravity-ide) echo 4 ;;
        antigravity) echo 5 ;;
        zed|dev.zed.Zed) echo 6 ;;
        jetbrains-*) echo 7 ;;

        # TAG 4: Work / Office
        chrome-kjbdgfilnfhdoflbpgamdcdgpehopbep-Default) echo 1 ;;

        # TAG 6: Creative / Design / Media
        chrome-agimnkijcaahngcdmfeangaknmldooml-Default) echo 1 ;;
        chrome-cinhimbnkkaeohfgghhklpknlkffjgod-Default) echo 2 ;;
        "Mullvad Browser") echo 3 ;;
        Spotify) echo 4 ;;

        # TAG 7: Productivity / Content
        knowledge-productivity) echo 1 ;;
        chrome-idkejijbjcgdnloelolopdemkebfadai-Default) echo 2 ;;
        *) return 1 ;;
    esac
}

mark_existing() {
    niri msg --json windows 2>/dev/null | jq -r '.[].id' 2>/dev/null |
    while read -r id; do
        [[ -n "$id" ]] && : > "$state_dir/$id"
    done
}

place_once() {
    local id="$1" app="$2" idx focused
    [[ -n "$id" && -n "$app" ]] || return 0
    [[ ! -e "$state_dir/$id" ]] || return 0
    : > "$state_dir/$id"
    idx="$(target_index "$app")" || return 0
    sleep 0.08
    focused="$(niri msg --json windows 2>/dev/null | jq -r '.[] | select(.is_focused == true) | .id' | head -n1)"
    niri msg action focus-window --id "$id" >/dev/null 2>&1 || return 0
    niri msg action move-column-to-index "$idx" >/dev/null 2>&1 || true
    if [[ -n "$focused" && "$focused" != "$id" ]]; then
        niri msg action focus-window --id "$focused" >/dev/null 2>&1 || true
    fi
}

mark_existing
niri msg --json event-stream 2>/dev/null |
while IFS= read -r event; do
    payload="$(jq -c '.WindowOpenedOrChanged.window // empty' <<<"$event" 2>/dev/null)"
    [[ -n "$payload" ]] || continue
    id="$(jq -r '.id // empty' <<<"$payload")"
    app="$(jq -r '.app_id // empty' <<<"$payload")"
    place_once "$id" "$app"
done
