#!/usr/bin/env bash
set -u

# Deterministic daily Niri session.
# Launch one window at a time and wait until Niri sees it before continuing.

has_window() {
    niri msg windows 2>/dev/null | grep -Fq "App ID: \"$1\""
}

wait_window() {
    local app_id="$1"
    local i
    for i in $(seq 1 100); do
        has_window "$app_id" && return 0
        sleep 0.1
    done
    return 1
}

launch_window() {
    local app_id="$1"
    shift

    if ! has_window "$app_id"; then
        "$@" >/dev/null 2>&1 &
        wait_window "$app_id" || true
    fi
}

# Workspace 1: exact left-to-right order.
launch_window "google-chrome" google-chrome-stable --new-window
launch_window "chrome-cadlkienfkclaiaibeoongdcgmdikeeg-Default" /opt/google/chrome/google-chrome --profile-directory=Default --app-id=cadlkienfkclaiaibeoongdcgmdikeeg
launch_window "chrome-mjoklplbddabcmpepnokjaffbmgbkkgg-Default" /opt/google/chrome/google-chrome --profile-directory=Default --app-id=mjoklplbddabcmpepnokjaffbmgbkkgg
launch_window "chrome-mhpcpiccfiaoabcaedpafgjabjjheekk-Default" /opt/google/chrome/google-chrome --profile-directory=Default --app-id=mhpcpiccfiaoabcaedpafgjabjjheekk
launch_window "org.gnome.Nautilus" nautilus --new-window

# Workspace 2 and 3.
launch_window "foot" /usr/local/bin/foot
launch_window "code" code

# Workspace 6: exact left-to-right order.
launch_window "chrome-agimnkijcaahngcdmfeangaknmldooml-Default" /opt/google/chrome/google-chrome --profile-directory=Default --app-id=agimnkijcaahngcdmfeangaknmldooml
launch_window "chrome-cinhimbnkkaeohfgghhklpknlkffjgod-Default" /opt/google/chrome/google-chrome --profile-directory=Default --app-id=cinhimbnkkaeohfgghhklpknlkffjgod
launch_window "Mullvad Browser" mullvad-browser
launch_window "Spotify" /usr/sbin/spotify

# Workspace 7.
launch_window "knowledge-productivity" /home/murat/.local/bin/knowledge-productivity
launch_window "chrome-idkejijbjcgdnloelolopdemkebfadai-Default" /opt/google/chrome/google-chrome --profile-directory=Default --app-id=idkejijbjcgdnloelolopdemkebfadai
