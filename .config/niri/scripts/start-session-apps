#!/usr/bin/env bash
set -u

state_file="${XDG_STATE_HOME:-$HOME/.local/state}/niri-session/enabled"
apps_file="${NIRI_APPS_FILE:-$HOME/.config/niri/apps.json}"

command -v jq >/dev/null 2>&1 || exit 0
[[ -r "$apps_file" ]] || exit 0

if [[ ! -f "$state_file" ]] || ! grep -qx 'on' "$state_file"; then
    exit 0
fi

has_window() {
    niri msg --json windows 2>/dev/null |
        jq -e --arg app "$1" '.[] | select(.app_id == $app)' >/dev/null 2>&1
}

wait_window() {
    local app_id="$1"
    local i
    for i in $(seq 1 120); do
        has_window "$app_id" && return 0
        sleep 0.1
    done
    return 1
}

launch_window() {
    local app_id="$1"
    shift
    if ! has_window "$app_id"; then
        "$@" >/dev/null 2>&1 &
        wait_window "$app_id" || true
    fi
}

# Chrome bootstrap remains generic infrastructure, not an app list.
if jq -e '.workspaces[].apps[] | select(.startup == true) | .exec[]? | select(test("google-chrome|/chrome$"))' "$apps_file" >/dev/null 2>&1 &&
   ! pgrep -f '/opt/google/chrome/(google-chrome|chrome)' >/dev/null 2>&1; then
    /opt/google/chrome/google-chrome         --profile-directory=Default         --no-first-run         --no-default-browser-check         --disable-session-crashed-bubble         --no-startup-window         >/dev/null 2>&1 &
    for _ in $(seq 1 100); do
        pgrep -f '/opt/google/chrome/(google-chrome|chrome)' >/dev/null 2>&1 && break
        sleep 0.1
    done
    sleep 1
fi

# apps.json is the only startup application list and order source.
while IFS= read -r entry; do
    app_id="$(jq -r '.app_id' <<<"$entry")"
    mapfile -t cmd < <(jq -r '.exec[]' <<<"$entry")
    [[ -n "$app_id" && "${#cmd[@]}" -gt 0 ]] || continue
    launch_window "$app_id" "${cmd[@]}"
done < <(jq -c '.workspaces[].apps[] | select(.startup == true)' "$apps_file")
