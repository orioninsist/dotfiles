#!/usr/bin/env bash
set -euo pipefail
project="$HOME/.config/niri/niri-apps"
binary="${XDG_CACHE_HOME:-$HOME/.cache}/niri-apps/niri-apps"
mkdir -p "$(dirname "$binary")"
if [[ ! -x "$binary" || "$project/Cargo.toml" -nt "$binary" || "$project/src/main.rs" -nt "$binary" ]]; then
    cargo build --release --manifest-path "$project/Cargo.toml"
    install -m755 "$project/target/release/niri-apps" "$binary"
fi
exec "$binary"
