#!/usr/bin/env bash

set -euo pipefail

export LD_LIBRARY_PATH=/usr/lib


RECORD_DIR="$HOME/.record"
PID_FILE="$HOME/.cache/sway-record.pid"

WL_SCREENREC="/mnt/local/projects/wl-screenrec/target/release/wl-screenrec"
RECORDING_LOCK="$HOME/.config/sway/scripts/sway-recording-lock"

AUDIO_DEVICE="alsa_input.pci-0000_00_1f.3.analog-stereo"

mkdir -p "$RECORD_DIR" "$HOME/.cache"

# Toggle: stop the currently active screen recording.
if [[ -f "$PID_FILE" ]]; then
    PID="$(cat "$PID_FILE")"

    if kill -0 "$PID" 2>/dev/null; then
        kill -INT "$PID"
        notify-send "Screen Recording" "Stopping recording"
        exit 0
    fi

    rm -f "$PID_FILE"
fi

MODE="${1:-}"

case "$MODE" in
    1)
        OUTPUT="eDP-1"
        PREFIX="thinkpad"
        ;;
    2)
        OUTPUT="HDMI-A-1"
        PREFIX="asus"
        ;;
    3)
        OUTPUT=""
        PREFIX="area"
        ;;
    *)
        notify-send "Screen Recording" "Invalid recording mode"
        exit 1
        ;;
esac

# Prevent screen, camera and combined recording sessions from overlapping.
"$RECORDING_LOCK" acquire screen || exit 1
trap '"$RECORDING_LOCK" release screen' EXIT

if [[ "$MODE" == "3" ]]; then
    GEOMETRY="$(slurp)" || exit 0
fi

TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
OUTPUT_FILE="$RECORD_DIR/${PREFIX}_${TIMESTAMP}.mp4"

ARGS=(
    --filename "$OUTPUT_FILE"
    --audio
    --audio-device "$AUDIO_DEVICE"
    --audio-backend pulse
    --codec avc
    --low-power off
)

if [[ "$MODE" == "3" ]]; then
    ARGS+=(--geometry "$GEOMETRY")
else
    ARGS+=(--output "$OUTPUT")
fi

"$WL_SCREENREC" "${ARGS[@]}" &
PID=$!

echo "$PID" > "$PID_FILE"

notify-send "Screen Recording" "Recording started"

wait "$PID" || true

rm -f "$PID_FILE"

notify-send "Screen Recording" "Recording finished: $OUTPUT_FILE"
