#!/usr/bin/env python3

import glob
import os
import re
import subprocess
import sys

MAIN_CONFIG = os.path.expanduser("~/.config/sway/config")
FOOT_BIN = "/usr/local/bin/foot"
APP_ID = "sway-shortcuts"

variables = {}
bindings = []
visited = set()


def expand_vars(text):
    previous = None
    while text != previous:
        previous = text
        for name, value in variables.items():
            text = text.replace(f"${name}", value)
    return text


def collect_files(path):
    path = os.path.expanduser(path)

    for resolved in glob.glob(path):
        resolved = os.path.realpath(resolved)

        if resolved in visited or not os.path.isfile(resolved):
            continue

        visited.add(resolved)

        try:
            with open(resolved, "r", encoding="utf-8") as handle:
                lines = handle.readlines()
        except OSError:
            continue

        for line in lines:
            stripped = line.strip()

            match = re.match(r"set\s+\$(\S+)\s+(.+)$", stripped)
            if match:
                variables[match.group(1)] = match.group(2).strip().strip('"')

        for line in lines:
            stripped = line.strip()

            match = re.match(r"include\s+(.+)$", stripped)
            if not match:
                continue

            include_path = expand_vars(match.group(1).strip().strip('"'))
            include_path = os.path.expanduser(include_path)

            if include_path.startswith(os.path.expanduser("~/.config/sway/")):
                collect_files(include_path)


def describe(action):
    action = expand_vars(action)

    rules = [
        (r"^kill$", "Close focused window"),
        (r"^reload$", "Reload Sway configuration"),
        (r"^fullscreen(?:\s+toggle)?$", "Toggle fullscreen"),
        (r"^floating toggle$", "Toggle floating / tiled"),
        (r"^focus mode_toggle$", "Switch focus between tiled and floating"),
        (r"^focus parent$", "Focus parent container"),
        (r"^focus child$", "Focus child container"),
        (r"^focus next$", "Focus next container"),
        (r"^focus prev$", "Focus previous container"),
        (r"^focus (left|right|up|down)$", r"Focus \1"),
        (r"^focus output (left|right|up|down)$", r"Focus output \1"),
        (r"^move (left|right|up|down)$", r"Move container \1"),
        (r"^move container to output (left|right|up|down)$", r"Move container to output \1"),
        (r"^move workspace to output (left|right|up|down)$", r"Move workspace to output \1"),
        (r"^move position center$", "Center floating window"),
        (r"^move scratchpad$", "Move window to scratchpad"),
        (r"^scratchpad show$", "Show / hide scratchpad"),
        (r"^splith$", "Set horizontal split"),
        (r"^splitv$", "Set vertical split"),
        (r"^layout stacking$", "Use stacking layout"),
        (r"^layout tabbed$", "Use tabbed layout"),
        (r"^layout toggle split$", "Toggle split layout"),
        (r"^border toggle$", "Toggle window border"),
        (r"^bar .+ mode toggle$", "Show / hide Sway bar"),
        (r"^workspace back_and_forth$", "Switch to previous workspace"),
        (r"^workspace next_on_output$", "Next workspace on current output"),
        (r"^workspace (.+)$", r"Switch to workspace \1"),
        (r"^move container to workspace (.+)$", r"Move window to workspace \1"),
        (r"^resize shrink width .+$", "Decrease window width"),
        (r"^resize grow width .+$", "Increase window width"),
        (r"^resize shrink height .+$", "Decrease window height"),
        (r"^resize grow height .+$", "Increase window height"),
        (r"^mark .+$", "Mark focused window"),
        (r'^\[con_mark="[^"]+"\] focus$', "Focus marked window"),
        (r'^mode "([^"]+)"$', r"Enter \1 mode"),
        (r"^move (left|right|up|down) \d+ px$", r"Move floating window \1"),
    ]

    for pattern, replacement in rules:
        if re.match(pattern, action):
            return re.sub(pattern, replacement, action)

    if action.startswith("exec "):
        command = action[5:].strip()

        special = [
            ("manual-swaylock-suspend", "Lock and suspend"),
            ("wlsunset-toggle", "Toggle night color"),
            ("mako-toggle", "Toggle notifications"),
            ("bluetooth-toggle", "Toggle Bluetooth"),
            ("audio-toggle", "Switch audio output"),
            ("mic-toggle", "Toggle microphone"),
            ("camera-toggle", "Toggle camera"),
            ("screenshot-area-clipboard", "Screenshot area to clipboard"),
            ("screenshot-area", "Screenshot selected area"),
            ("screenshot-thinkpad", "Screenshot ThinkPad display"),
            ("screenshot-asus", "Screenshot ASUS display"),
            ("sway-camera-record", "Record camera"),
            ("sway-screen-camera-record", "Record screen and camera"),
            ("sway-record 1", "Record screen 1"),
            ("sway-record 2", "Record screen 2"),
            ("sway-record 3", "Record screen 3"),
            ("sway-ocr", "OCR selected screen area"),
            ("cliphist-fzf", "Open clipboard history"),
            ("whisper-type", "Start voice typing"),
            ("yazi", "Open Yazi"),
            ("nautilus", "Open GNOME Files"),
            ("alacritty", "Open Alacritty"),
            ("kitty", "Open Kitty"),
            ("PowerProfiles", "Change power profile"),
            ("xkb_switch_layout next", "Switch keyboard language"),
            ("swaynag", "Exit Sway"),
        ]

        for needle, description in special:
            if needle in command:
                return description

        executable = command.split()[0]
        return f"Run {os.path.basename(executable)}"

    return action


def parse_bindings(path, mode="default"):
    path = os.path.realpath(path)

    try:
        with open(path, "r", encoding="utf-8") as handle:
            lines = handle.readlines()
    except OSError:
        return

    current_mode = mode
    mode_depth = 0

    for raw_line in lines:
        stripped = raw_line.strip()

        if not stripped or stripped.startswith("#"):
            continue

        mode_match = re.match(r'mode\s+(?:\$[\w_]+|"([^"]+)")\s*\{', stripped)
        if mode_match:
            current_mode = mode_match.group(1) or "custom"
            mode_depth = 1
            continue

        if mode_depth:
            mode_depth += stripped.count("{")
            mode_depth -= stripped.count("}")

            if mode_depth <= 0:
                current_mode = "default"
                mode_depth = 0
                continue

        include_match = re.match(r"include\s+(.+)$", stripped)
        if include_match:
            include_path = expand_vars(include_match.group(1).strip().strip('"'))
            include_path = os.path.expanduser(include_path)

            for included in glob.glob(include_path):
                if included.startswith(os.path.expanduser("~/.config/sway/")):
                    parse_bindings(included, current_mode)
            continue

        bind_match = re.match(r"bindsym\s+(.+)$", stripped)
        if not bind_match:
            continue

        payload = bind_match.group(1)

        while payload.startswith("--"):
            parts = payload.split(maxsplit=1)
            if len(parts) < 2:
                break
            payload = parts[1]

        parts = payload.split(maxsplit=1)
        if len(parts) != 2:
            continue

        key, action = parts
        key = expand_vars(key)

        display_mode = current_mode
        if display_mode == "custom":
            display_mode = "mode"

        bindings.append((display_mode, key, action))


def normalized_key(key):
    key = key.replace("Mod4", "Super")
    key = key.replace("Ctrl", "Ctrl")
    key = key.replace("Shift", "Shift")
    key = key.replace("Alt", "Alt")
    key = key.replace("Caps_Lock", "CapsLock")
    key = key.replace("minus", "-")
    key = key.replace("space", "Space")
    return key


def print_bindings():
    seen = set()

    for mode, key, action in bindings:
        key = normalized_key(key)
        description = describe(action)

        if mode != "default":
            key = f"[{mode}] {key}"

        item = (key, description)

        if item in seen:
            continue

        seen.add(item)
        print(f"{key}\t{description}")


collect_files(MAIN_CONFIG)
parse_bindings(MAIN_CONFIG)

if "--print" in sys.argv:
    print_bindings()
    sys.exit(0)

if "--inside" in sys.argv:
    process = subprocess.Popen(
        [
            "fzf",
            "--no-multi",
            "--layout=reverse",
            "--info=hidden",
            "--prompt=",
            "--border=rounded",
            "--header=SWAY SHORTCUTS",
            "--delimiter=\t",
            "--with-nth=1,2",
        ],
        stdin=subprocess.PIPE,
        text=True,
    )

    output = subprocess.run(
        [sys.executable, __file__, "--print"],
        capture_output=True,
        text=True,
        check=True,
    )

    process.communicate(output.stdout)
    sys.exit(0)

os.execv(
    FOOT_BIN,
    [
        FOOT_BIN,
        f"--app-id={APP_ID}",
        "--title=Sway Shortcuts",
        sys.executable,
        __file__,
        "--inside",
    ],
)
