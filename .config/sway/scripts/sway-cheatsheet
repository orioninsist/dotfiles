#!/usr/bin/env bash
set -euo pipefail

SWAY_DIR="$HOME/.config/sway"
SCRIPT_DIR="$SWAY_DIR/scripts"

declare -a CONFIG_FILES=()
declare -A SEEN=()
declare -A VARS=()

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

expand_vars() {
    local text="$1"
    local name

    for name in "${!VARS[@]}"; do
        text="${text//\$$name/${VARS[$name]}}"
    done

    printf '%s' "$text"
}

add_config() {
    local file="$1"
    local include
    local resolved
    local line
    local name
    local value

    file="${file/#\~/$HOME}"

    [[ -f "$file" ]] || return 0
    [[ -n "${SEEN[$file]:-}" ]] && return 0

    SEEN["$file"]=1
    CONFIG_FILES+=("$file")

    while IFS= read -r line; do
        line="$(trim "$line")"

        if [[ "$line" =~ ^set[[:space:]]+\$([A-Za-z0-9_]+)[[:space:]]+(.+)$ ]]; then
            name="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"
            VARS["$name"]="$(expand_vars "$value")"
        fi
    done < "$file"

    while IFS= read -r include; do
        include="${include%%#*}"
        include="$(trim "$include")"

        [[ -n "$include" ]] || continue

        include="${include//\$HOME/$HOME}"
        include="${include/#\~/$HOME}"
        include="$(expand_vars "$include")"

        if [[ "$include" != /* ]]; then
            include="$SWAY_DIR/$include"
        fi

        for resolved in $include; do
            add_config "$resolved"
        done
    done < <(
        sed -nE 's/^[[:space:]]*include[[:space:]]+//p' "$file"
    )
}

human_key() {
    local key="$1"

    key="$(expand_vars "$key")"
    key="${key//\$mod/Super}"
    key="${key//Mod4/Super}"
    key="${key//Ctrl/Control}"
    key="${key//Return/Enter}"
    key="${key//Print/Print Screen}"

    printf '%s' "$key"
}

describe_command() {
    local command="$1"

    command="$(expand_vars "$command")"

    case "$command" in
        exec*"sway-ocr"*)
            printf 'Selected area OCR and copy text'
            ;;
        exec*"sway-screen-camera-record"*)
            printf 'Toggle screen and camera recording'
            ;;
        exec*"sway-camera-record"*)
            printf 'Toggle camera recording'
            ;;
        exec*"sway-record 1"*)
            printf 'Toggle ThinkPad screen recording'
            ;;
        exec*"sway-record 2"*)
            printf 'Toggle ASUS screen recording'
            ;;
        exec*"sway-record 3"*)
            printf 'Toggle selected-area recording'
            ;;
        exec*"sway-manual-lock"*)
            printf 'Lock session'
            ;;
        exec*"cliphist-fzf"*)
            printf 'Open clipboard history'
            ;;
        exec*"wlsunset-toggle"*)
            printf 'Toggle night light'
            ;;
        exec*"mako-toggle"*)
            printf 'Toggle notifications'
            ;;
        exec*"screenshot-area-clipboard"*)
            printf 'Capture selected area to clipboard'
            ;;
        exec*"screenshot-area"*)
            printf 'Capture selected area'
            ;;
        exec*"screenshot-asus"*)
            printf 'Capture ASUS display'
            ;;
        exec*"screenshot-thinkpad"*)
            printf 'Capture ThinkPad display'
            ;;
        exec*"yazi"*)
            printf 'Open Yazi file manager'
            ;;

        "focus left")
            printf 'Focus window on the left'
            ;;
        "focus right")
            printf 'Focus window on the right'
            ;;
        "focus up")
            printf 'Focus window above'
            ;;
        "focus down")
            printf 'Focus window below'
            ;;

        "move left")
            printf 'Move window left'
            ;;
        "move right")
            printf 'Move window right'
            ;;
        "move up")
            printf 'Move window up'
            ;;
        "move down")
            printf 'Move window down'
            ;;

        "splith")
            printf 'Split next window horizontally'
            ;;
        "splitv")
            printf 'Split next window vertically'
            ;;
        "layout stacking")
            printf 'Use stacking layout'
            ;;
        "layout tabbed")
            printf 'Use tabbed layout'
            ;;
        "layout toggle split")
            printf 'Toggle split orientation'
            ;;
        fullscreen*)
            printf 'Toggle fullscreen'
            ;;
        "floating toggle")
            printf 'Toggle floating mode'
            ;;
        "focus mode_toggle")
            printf 'Switch focus between floating and tiled windows'
            ;;
        "focus parent")
            printf 'Focus parent container'
            ;;
        "move scratchpad")
            printf 'Move focused window to scratchpad'
            ;;
        "scratchpad show")
            printf 'Show or cycle scratchpad windows'
            ;;
        "kill")
            printf 'Close focused window'
            ;;
        "reload")
            printf 'Reload Sway configuration'
            ;;
        "exit")
            printf 'Exit Sway'
            ;;
        move*"workspace"*)
            printf 'Move focused window to workspace'
            ;;
        workspace*)
            printf 'Switch workspace'
            ;;
        resize*)
            printf 'Resize focused window'
            ;;
        exec*)
            printf 'Run command'
            ;;
        *)
            printf '%s' "$command"
            ;;
    esac
}

add_config "$SWAY_DIR/config"

printf '# Sway Shortcuts\n\n'
printf '> Generated live from the active Sway configuration.\n\n'

for file in "${CONFIG_FILES[@]}"; do
    while IFS= read -r line; do
        line="$(trim "$line")"

        [[ "$line" =~ ^(bindsym|bindcode)[[:space:]]+ ]] || continue

        line="${line#bindsym }"
        line="${line#bindcode }"

        while [[ "$line" == --* ]]; do
            line="${line#* }"
        done

        key="${line%% *}"
        command="${line#* }"

        [[ "$command" != "$line" ]] || continue

        printf '### `%s`\n\n' "$(human_key "$key")"
        printf '%s\n\n' "$(describe_command "$command")"
    done < "$file"
done

printf '## Scripts\n\n'

while IFS= read -r file; do
    name="$(basename "$file")"

    case "$name" in
        sway-cheatsheet|validate-centralized-scripts.sh)
            continue
            ;;
    esac

    printf '### `%s`\n\n' "$name"
done < <(
    find "$SCRIPT_DIR" -maxdepth 1 -type f -perm /111 -print | sort
)
