#!/usr/bin/bash
set -u

selection=$(
    /usr/local/bin/cliphist list |
        $HOME/.local/bin/fzf --prompt="Clipboard> " --reverse --border
) || exit 0

[[ -n "$selection" ]] || exit 0

tmp=$(/usr/bin/mktemp "${XDG_RUNTIME_DIR}/cliphist-copy.XXXXXX")

printf '%s\n' "$selection" |
    /usr/local/bin/cliphist decode > "$tmp" || true

[[ -s "$tmp" ]] || {
    /usr/bin/rm -f "$tmp"
    exit 1
}

/usr/bin/systemd-run --user --quiet \
    /usr/bin/bash -c '
        exec 0<"$1"
        /usr/bin/rm -f "$1"
        exec $HOME/.local/bin/wl-copy --foreground
    ' bash "$tmp"
