#!/usr/bin/env bash

set -euo pipefail

SCREENSHOT_DIR="$HOME/.screenshoot"
TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
OUTPUT_FILE="$SCREENSHOT_DIR/thinkpad_${TIMESTAMP}.png"

WL_COPY="$HOME/.local/bin/wl-copy"
SATTY="$HOME/.local/bin/satty"

mkdir -p "$SCREENSHOT_DIR"

grim -o eDP-1 "$OUTPUT_FILE"
"$WL_COPY" --type image/png < "$OUTPUT_FILE"
"$SATTY" --filename "$OUTPUT_FILE"

notify-send "Screenshot" "ThinkPad saved: $OUTPUT_FILE"
