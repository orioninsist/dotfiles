#!/usr/bin/env bash

set -u

SWAY_DIR="$HOME/.config/sway"
ASSIGNMENTS="$SWAY_DIR/app-assignments.conf"
OUT="$HOME/app_assignments_audit.txt"

{
    echo "===== CONFIGURED APP_ID / CLASS ====="

    grep -nE '^[[:space:]]*for_window ' "$ASSIGNMENTS" |
    sed -nE '
        s/^([0-9]+):.*\[app_id="([^"]+)".*/line=\1 app_id=\2/p
        s/^([0-9]+):.*\[class="([^"]+)".*/line=\1 class=\2/p
    ' | sort

    echo
    echo "===== DUPLICATE SELECTORS ====="

    grep -E '^[[:space:]]*for_window ' "$ASSIGNMENTS" |
    sed -nE '
        s/.*\[app_id="([^"]+)".*/app_id=\1/p
        s/.*\[class="([^"]+)".*/class=\1/p
    ' |
    sort |
    uniq -c |
    awk '$1 > 2 {print}'

    echo
    echo "===== CONFIGURED WORKSPACE TARGETS ====="

    grep -E '^[[:space:]]*for_window ' "$ASSIGNMENTS" |
    sed -nE 's/.*workspace "([^"]+)".*/\1/p' |
    sort -u

    echo
    echo "===== DECLARED WORKSPACES ====="

    sed -nE 's/^[[:space:]]*workspace "([^"]+)".*/\1/p' \
        "$SWAY_DIR/workspaces.conf" |
    sort -u

    echo
    echo "===== INVALID WORKSPACE TARGETS ====="

    comm -23 \
        <(
            grep -E '^[[:space:]]*for_window ' "$ASSIGNMENTS" |
            sed -nE 's/.*workspace "([^"]+)".*/\1/p' |
            sort -u
        ) \
        <(
            sed -nE 's/^[[:space:]]*workspace "([^"]+)".*/\1/p' \
                "$SWAY_DIR/workspaces.conf" |
            sort -u
        )

    echo
    echo "===== CURRENT RUNNING WINDOWS ====="

    swaymsg -t get_tree -r |
    jq -r '
        .. | objects |
        select(
            .type? == "con" and
            (.app_id? != null or .window_properties?.class? != null)
        ) |
        [
            ("app_id=" + (.app_id // "null")),
            ("class=" + (.window_properties.class // "null")),
            ("instance=" + (.window_properties.instance // "null")),
            ("title=" + (.name // "null"))
        ] |
        @tsv
    ' |
    sort -u

    echo
    echo "===== DESKTOP ENTRY IDENTITIES ====="

    find \
        "$HOME/.local/share/applications" \
        /usr/local/share/applications \
        /usr/share/applications \
        -maxdepth 1 \
        -type f \
        -name '*.desktop' \
        -print0 2>/dev/null |
    while IFS= read -r -d '' file; do
        name="$(grep -m1 '^Name=' "$file" 2>/dev/null | cut -d= -f2-)"
        startup="$(grep -m1 '^StartupWMClass=' "$file" 2>/dev/null | cut -d= -f2-)"
        exec_line="$(grep -m1 '^Exec=' "$file" 2>/dev/null | cut -d= -f2-)"

        printf '%s\tName=%s\tStartupWMClass=%s\tExec=%s\n' \
            "$(basename "$file")" \
            "${name:--}" \
            "${startup:--}" \
            "${exec_line:--}"
    done |
    sort

    echo
    echo "===== CHROME WEB APPS ====="

    find "$HOME/.local/share/applications" \
        -maxdepth 1 \
        -type f \
        -name 'chrome-*-Default.desktop' \
        -print0 2>/dev/null |
    while IFS= read -r -d '' file; do
        name="$(grep -m1 '^Name=' "$file" | cut -d= -f2-)"
        app_id="$(basename "$file" | sed -E 's/^chrome-([^-]+)-Default\.desktop$/\1/')"

        printf '%s\tchrome-%s-Default\n' "$name" "$app_id"
    done |
    sort

    echo
    echo "===== SWAY VALIDATION ====="

    sway -C 2>&1

} > "$OUT"

printf 'Audit written to: %s\n' "$OUT"
