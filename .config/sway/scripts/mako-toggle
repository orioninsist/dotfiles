#!/usr/bin/env bash

exec > /tmp/mako-toggle.log 2>&1

echo "START $(date)"

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

STATE_FILE="$HOME/.cache/mako-popup-state"

/home/murat/.config/sway/bin/makoctl mode

if /home/murat/.config/sway/bin/makoctl mode | grep -q "do-not-disturb"; then
    /home/murat/.config/sway/bin/makoctl mode -r do-not-disturb
    echo enabled > "$STATE_FILE"
else
    /home/murat/.config/sway/bin/makoctl mode -a do-not-disturb
    echo disabled > "$STATE_FILE"
fi

pkill -RTMIN+8 waybar 2>/dev/null || true

echo "END $(date)"
