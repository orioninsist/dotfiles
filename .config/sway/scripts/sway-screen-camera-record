#!/usr/bin/env bash

set -euo pipefail

export LD_LIBRARY_PATH=/usr/lib

RECORD_DIR="$HOME/.record"
PID_FILE="$HOME/.cache/sway-screen-camera-record.pid"

WL_SCREENREC="/usr/local/bin/wl-screenrec"
FFMPEG="/usr/bin/ffmpeg"
FFPROBE="/usr/bin/ffprobe"
RECORDING_LOCK="$HOME/.config/sway/scripts/sway-recording-lock"

OUTPUT="eDP-1"
CAMERA="/dev/video0"
MIC="alsa_input.pci-0000_00_1f.3.analog-stereo"
SPEAKER="alsa_output.pci-0000_00_1f.3.analog-stereo.monitor"

mkdir -p "$RECORD_DIR" "$HOME/.cache"

# Toggle: stop the active combined recording.
# Finalization is performed by the original recording process.
if [[ -f "$PID_FILE" ]]; then
    read -r CAMERA_PID SCREEN_PID TIMESTAMP < "$PID_FILE"

    camera_running=false
    screen_running=false

    kill -0 "$CAMERA_PID" 2>/dev/null && camera_running=true
    kill -0 "$SCREEN_PID" 2>/dev/null && screen_running=true

    if [[ "$camera_running" == true || "$screen_running" == true ]]; then
        notify-send "Screen + Camera Recording" "Stopping recording"

        kill -INT "$SCREEN_PID" 2>/dev/null || true
        kill -INT "$CAMERA_PID" 2>/dev/null || true

        exit 0
    fi

    rm -f "$PID_FILE"
fi

# Prevent all recording modes from overlapping.
"$RECORDING_LOCK" acquire screen-camera || exit 1
trap '"$RECORDING_LOCK" release screen-camera' EXIT

TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"

SCREEN_FILE="$RECORD_DIR/screen_${TIMESTAMP}.mp4"
CAMERA_FILE="$RECORD_DIR/camera_${TIMESTAMP}.mkv"
OUTPUT_FILE="$RECORD_DIR/screen_camera_${TIMESTAMP}.mp4"

"$FFMPEG" \
    -f v4l2 \
    -input_format mjpeg \
    -framerate 30 \
    -video_size 1280x720 \
    -i "$CAMERA" \
    -f pulse \
    -i "$MIC" \
    -f pulse \
    -i "$SPEAKER" \
    -map 0:v \
    -map 1:a \
    -map 2:a \
    -c:v libx264 \
    -c:a aac \
    "$CAMERA_FILE" &

CAMERA_PID=$!

"$WL_SCREENREC" \
    --output "$OUTPUT" \
    --codec avc \
    --low-power off \
    --filename "$SCREEN_FILE" &

SCREEN_PID=$!

printf '%s %s %s\n' \
    "$CAMERA_PID" \
    "$SCREEN_PID" \
    "$TIMESTAMP" > "$PID_FILE"

notify-send "Screen + Camera Recording" "Recording started"

# Keep the owner process alive until both recording processes finish.
wait "$SCREEN_PID" 2>/dev/null || true
wait "$CAMERA_PID" 2>/dev/null || true

rm -f "$PID_FILE"

# Give both containers time to finish writing their indexes.
sleep 1

if [[ ! -s "$SCREEN_FILE" || ! -s "$CAMERA_FILE" ]]; then
    notify-send "Screen + Camera Recording" "Recording files are incomplete"
    exit 1
fi

SCREEN_DURATION="$(
    "$FFPROBE" \
        -v error \
        -select_streams v:0 \
        -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 \
        "$SCREEN_FILE" 2>/dev/null || true
)"

if [[ -z "$SCREEN_DURATION" || "$SCREEN_DURATION" == "N/A" || "$SCREEN_DURATION" == "0.000000" ]]; then
    notify-send "Screen + Camera Recording" "Screen recording was not finalized"
    exit 1
fi

"$FFMPEG" \
    -fflags +genpts \
    -i "$SCREEN_FILE" \
    -fflags +genpts \
    -i "$CAMERA_FILE" \
    -filter_complex "[0:v]fps=30,settb=1/30[screen];[1:v]fps=30,scale=320:-1[camera];[screen][camera]overlay=W-w-24:H-h-24[outv]" \
    -map "[outv]" \
    -map 1:a:0 \
    -map 1:a:1 \
    -c:v libx264 \
    -c:a aac \
    -shortest \
    -movflags +faststart \
    "$OUTPUT_FILE"

if "$FFPROBE" -v error "$OUTPUT_FILE" >/dev/null 2>&1; then
    rm -f "$SCREEN_FILE" "$CAMERA_FILE"
    notify-send "Screen + Camera Recording" "Recording finished: $OUTPUT_FILE"
else
    notify-send "Screen + Camera Recording" "Final MP4 validation failed"
    exit 1
fi
