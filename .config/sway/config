# Sway main configuration

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term /usr/local/bin/foot
set $menu wmenu-run

### Core bindings
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+Shift+c reload

### Input
include ~/.config/sway/input.conf

### Outputs
include ~/.config/sway/outputs.conf

### Workspaces
include ~/.config/sway/workspaces.conf

### Window management
include ~/.config/sway/window-management.conf

### System controls
include ~/.config/sway/system-controls.conf

### Capture
include ~/.config/sway/capture.conf

### Application and utility shortcuts
include ~/.config/sway/shortcuts.conf

### Application workspace assignments
include ~/.config/sway/app-assignments.conf

### Swaybar
include ~/.config/sway/bar.conf

### Session
include ~/.config/sway/session.conf

### XWayland
xwayland force
