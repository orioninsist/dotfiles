

# systemd user enable state (symlinks into this live dotfiles tree)
.config/systemd/user/*.wants/

# Python test bytecode
__pycache__/
*.py[cod]

# Generated Zellij plugin artifacts
.config/zellij/plugins/*/dist/*.wasm

# Desktop runtime state
.config/gtk-3.0/bookmarks

# Private recovery material - NEVER COMMIT
.config/rclone/rclone.conf
.config/orion-recovery/

# Machine-local generated Knowledge config
.config/knowledge/workspaces.toml
