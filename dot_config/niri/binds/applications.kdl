binds {
    Mod+Return { spawn "kitty"; }
    Mod+D {  spawn "fuzzel" "--anchor=center" "--width=45" "--lines=10" "--font=monospace:size=12" "--icon-theme=Adwaita" "--match-mode=fuzzy" "--fields=name,generic,keywords" "--placeholder=Uygulama ara..." "--prompt=>" "--counter" "--show-actions" "--border-radius=12" "--selection-radius=8" "--border-width=1" "--horizontal-pad=24" "--vertical-pad=10" "--dpi-aware=auto" "--layer=overlay" "--keyboard-focus=exclusive"; }
    Mod+C { spawn "/home/murat/.config/wayland/scripts/espanso-search"; }
    Mod+Y { spawn "kitty" "yazi"; }
    Mod+P { spawn "/home/murat/.config/wayland/scripts/satty-screenshot"; }
    Mod+Ctrl+O { spawn "obs"; }
    Mod+N { spawn "/home/murat/.config/wayland/scripts/mako-toggle"; }
    Mod+Shift+N { spawn "/home/murat/.config/wayland/scripts/wlsunset-toggle"; }
    Mod+Ctrl+N { spawn "/home/murat/.config/wayland/scripts/notification-history"; }
    Mod+Ctrl+E { spawn "/home/murat/.config/wayland/scripts/emoji-picker"; }
    Mod+S { spawn "/home/murat/.config/wayland/scripts/system-status"; }
    Mod+Ctrl+Space { switch-layout "next"; }
    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Mod+Ctrl+Print { screenshot-window; }
    Mod+Ctrl+Shift+Print { spawn "/home/murat/.config/wayland/scripts/ocr"; }
    Mod+I { spawn "/home/murat/.config/wayland/scripts/commands/whisper-type"; }
    Mod+Shift+I { spawn "/home/murat/.config/wayland/scripts/commands/whisper-type" "en"; }
    Mod+Ctrl+P { spawn "wl-color-picker" "clipboard" "--no-notify"; }
    Mod+F1 { spawn "/home/murat/.config/wayland/scripts/power-profile-toggle"; }
    Mod+T { spawn "/home/murat/.config/wayland/scripts/bluetooth-toggle"; }
    Mod+F4 { spawn "/home/murat/.config/wayland/scripts/audio-toggle"; }
    Mod+F5 { spawn "/home/murat/.config/wayland/scripts/mic-toggle"; }
    Mod+F6 { spawn "/home/murat/.config/wayland/scripts/camera-toggle"; }
    Mod+Shift+D { spawn "/home/murat/.config/niri/scripts/asus-monitor-toggle"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioStop allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    Mod+Shift+S { spawn "swaylock" "-f" "-c" "000000"; }
    Mod+Shift+C { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+Shift+Escape { quit; }
}
