{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 3,
  "margin-top": 3,
  "margin-left": 5,
  "margin-right": 5,
  "modules-left": [
    "custom/launcher",
    "cpu",
    "memory",
    "disk",
    "custom/temp-cpu",
    "custom/temp-mb",
    "custom/temp-pch",
    "custom/temp-ssd"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/powerprofile",
    "custom/mic",
    "custom/camera",
    "custom/bluetooth",
    "custom/night",
    "custom/notify",
    "pulseaudio",
    "network",
    "battery",
    "tray"
  ],
  "cpu": {
    "interval": 5,
    "format": "C{usage}%",
    "tooltip": false
  },
  "memory": {
    "interval": 5,
    "format": "M{}%",
    "tooltip": false
  },
  "clock": {
    "interval": 1,
    "interval": 30,
    "format": "{:%a %d %b  %H:%M:%S}",
    "tooltip-format": "{:%A, %d %B %Y  %H:%M}"
  },
  "custom/powerprofile": {
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "exec": "bash -lc \"$HOME/.config/wayland/scripts/power-profile-status\"",
    "on-click": "bash -lc \"$HOME/.config/wayland/scripts/power-profile-toggle\"",
    "tooltip": true
  },
  "custom/mic": {
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "exec": "bash -lc 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED && echo \"{\\\"text\\\":\\\"MIC-\\\",\\\"class\\\":\\\"off\\\",\\\"tooltip\\\":\\\"Mikrofon kapalı\\\"}\" || echo \"{\\\"text\\\":\\\"MIC\\\",\\\"class\\\":\\\"on\\\",\\\"tooltip\\\":\\\"Mikrofon açık\\\"}\"'",
    "on-click": "bash -lc \"$HOME/.config/wayland/scripts/mic-toggle\"",
    "tooltip": true
  },
  "custom/camera": {
    "interval": 3,
    "return-type": "json",
    "format": "{}",
    "exec": "bash -lc 'if fuser /dev/video* >/dev/null 2>&1; then echo \"{\\\"text\\\":\\\"CAM\\\",\\\"class\\\":\\\"on\\\",\\\"tooltip\\\":\\\"Kamera kullanımda\\\"}\"; else echo \"{\\\"text\\\":\\\"CAM-\\\",\\\"class\\\":\\\"off\\\",\\\"tooltip\\\":\\\"Kamera pasif\\\"}\"; fi'",
    "on-click": "bash -lc \"$HOME/.config/wayland/scripts/camera-toggle\"",
    "tooltip": true
  },
  "custom/bluetooth": {
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "exec": "bash -lc \"$HOME/.config/wayland/scripts/bluetooth-status\"",
    "on-click": "bash -lc \"$HOME/.config/wayland/scripts/bluetooth-toggle\"",
    "tooltip": true
  },
  "custom/night": {
    "interval": 3,
    "return-type": "json",
    "format": "{}",
    "exec": "bash -lc 'pgrep -x wlsunset >/dev/null 2>&1 && echo \"{\\\"text\\\":\\\"SUN\\\",\\\"class\\\":\\\"on\\\",\\\"tooltip\\\":\\\"Gece ışığı aktif\\\"}\" || echo \"{\\\"text\\\":\\\"SUN-\\\",\\\"class\\\":\\\"off\\\",\\\"tooltip\\\":\\\"Gece ışığı pasif\\\"}\"'",
    "on-click": "bash -lc \"$HOME/.config/wayland/scripts/wlsunset-toggle\"",
    "tooltip": true
  },
  "custom/notify": {
    "interval": 3,
    "return-type": "json",
    "format": "{}",
    "exec": "bash -lc 'makoctl mode 2>/dev/null | grep -q do-not-disturb && echo \"{\\\"text\\\":\\\"DND\\\",\\\"class\\\":\\\"off\\\",\\\"tooltip\\\":\\\"Bildirimler sessiz\\\"}\" || echo \"{\\\"text\\\":\\\"NOT\\\",\\\"class\\\":\\\"on\\\",\\\"tooltip\\\":\\\"Bildirimler açık\\\"}\"'",
    "on-click": "bash -lc \"$HOME/.config/wayland/scripts/mako-toggle\"",
    "tooltip": true
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "V{volume}%",
    "format-muted": "V-",
    "tooltip": false
  },
  "network": {
    "interval": 6,
    "format-wifi": "W",
    "format-ethernet": "L",
    "format-disconnected": "N-",
    "tooltip-format": "{essid} {ipaddr}"
  },
  "battery": {
    "interval": 20,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "B{capacity}%",
    "format-charging": "B{capacity}+",
    "format-plugged": "B{capacity}+",
    "tooltip": false
  },
  "tray": {
    "spacing": 6
  },
  "disk": {
    "interval": 20,
    "path": "/",
    "format": "D{percentage_used}%",
    "tooltip-format": "/ disk: {used} / {total}"
  },
  "custom/temp-cpu": {
    "interval": 5,
    "format": "{}",
    "exec": "bash -lc \"$HOME/.config/wayland/scripts/temp-cpu\"",
    "tooltip": false
  },
  "custom/temp-mb": {
    "interval": 5,
    "format": "{}",
    "exec": "bash -lc \"$HOME/.config/wayland/scripts/temp-mb\"",
    "tooltip": false
  },
  "custom/temp-pch": {
    "interval": 5,
    "format": "{}",
    "exec": "bash -lc \"$HOME/.config/wayland/scripts/temp-pch\"",
    "tooltip": false
  },
  "custom/temp-ssd": {
    "interval": 5,
    "format": "{}",
    "exec": "bash -lc \"$HOME/.config/wayland/scripts/temp-ssd\"",
    "tooltip": false
  }
}
