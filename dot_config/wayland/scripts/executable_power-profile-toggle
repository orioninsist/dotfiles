#!/usr/bin/env bash
set -euo pipefail

notify() {
    notify-send "Power Profile" "$1" 2>/dev/null || true
}

if ! command -v powerprofilesctl >/dev/null 2>&1; then
    notify "powerprofilesctl yok"
    exit 1
fi

current="$(powerprofilesctl get 2>/dev/null || echo unknown)"

case "$current" in
    performance)
        next="balanced"
        label="Balanced"
        ;;
    balanced)
        next="power-saver"
        label="Power saver"
        ;;
    power-saver)
        next="performance"
        label="Performance"
        ;;
    *)
        next="balanced"
        label="Balanced"
        ;;
esac

if powerprofilesctl set "$next" 2>/dev/null; then
    notify "$label"
else
    notify "Değiştirilemedi"
    exit 1
fi
