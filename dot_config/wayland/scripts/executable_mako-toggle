#!/usr/bin/env bash
set -euo pipefail

if ! systemctl --user is-active --quiet mako.service; then
    systemctl --user start mako.service
    notify-send "Mako" "Started"
    exit 0
fi

if makoctl mode 2>/dev/null | grep -q "do-not-disturb"; then
    makoctl mode -r do-not-disturb
    notify-send "Mako" "Notifications enabled"
else
    makoctl mode -a do-not-disturb
    notify-send "Mako" "Do not disturb enabled"
fi
