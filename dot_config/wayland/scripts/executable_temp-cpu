#!/usr/bin/env bash
for h in /sys/class/hwmon/hwmon*; do
  [ "$(cat "$h/name" 2>/dev/null)" = "coretemp" ] || continue
  for f in "$h"/temp*_input; do
    base="${f%_input}"
    [ "$(cat "${base}_label" 2>/dev/null)" = "Package id 0" ] || continue
    v="$(cat "$f" 2>/dev/null || true)"
    [ -n "$v" ] && echo "CPU$((v/1000))°" && exit 0
  done
done
echo "CPU?"
