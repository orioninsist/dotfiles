#!/usr/bin/env bash

json() {
    printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$1" "$2" "$3"
}

info="$(timeout 3s bluetoothctl show 2>/dev/null || true)"

if echo "$info" | grep -q "Powered: yes"; then
    json "BT" "active" "Bluetooth açık"
    exit 0
fi

if echo "$info" | grep -q "Powered: no"; then
    json "BT-" "passive" "Bluetooth kapalı"
    exit 0
fi

rf="$(rfkill list bluetooth 2>/dev/null || true)"

if echo "$rf" | grep -q "Hard blocked: yes"; then
    json "BTX" "blocked" "Bluetooth hard blocked"
    exit 0
fi

if echo "$rf" | grep -q "Soft blocked: yes"; then
    json "BT-" "passive" "Bluetooth rfkill kapalı"
    exit 0
fi

if echo "$rf" | grep -q "hci0"; then
    json "BT?" "unknown" "Bluetooth var ama BlueZ controller okuyamıyor"
    exit 0
fi

json "BTX" "blocked" "Bluetooth controller yok"
