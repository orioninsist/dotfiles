#!/usr/bin/env bash
set -euo pipefail

IMAGE="$HOME/.cache/wayland-ocr.png"
TEXT="$HOME/.cache/wayland-ocr.txt"

REGION="$(slurp)" || exit 0
grim -g "$REGION" "$IMAGE"

tesseract "$IMAGE" "$HOME/.cache/wayland-ocr" -l tur+eng --psm 6 2>/dev/null

if [[ ! -s "$TEXT" ]]; then
    sleep 0.15
    notify-send "OCR" "No text detected"
    exit 0
fi

wl-copy < "$TEXT"
sleep 0.15
notify-send "OCR copied" "$(head -c 160 "$TEXT")"
