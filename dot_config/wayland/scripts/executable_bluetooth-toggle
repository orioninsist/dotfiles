#!/usr/bin/env bash
set -euo pipefail

notify() {
    notify-send "Bluetooth" "$1" 2>/dev/null || true
}

read_info() {
    timeout 3s bluetoothctl show 2>/dev/null || true
}

power_state() {
    read_info | awk -F': ' '/Powered/ {print $2; exit}'
}

recover_controller() {
    rfkill unblock bluetooth 2>/dev/null || true

    # Servis restart yok. Sadece kullanıcı seviyesinde BlueZ'e adapter uyanması için komut gönder.
    timeout 2s bluetoothctl power on >/dev/null 2>&1 || true

}

state="$(power_state)"

case "$state" in
    yes)
        if timeout 3s bluetoothctl power off >/dev/null 2>&1; then
            notify "Kapalı"
        else
            notify "Kapatılamadı"
        fi
        ;;
    no)
        if timeout 3s bluetoothctl power on >/dev/null 2>&1; then
            notify "Açık"
        else
            notify "Açılamadı"
        fi
        ;;
    *)
        recover_controller
        state2="$(power_state)"
        case "$state2" in
            yes) notify "Açık" ;;
            no) notify "Kapalı" ;;
            *) notify "Controller hâlâ okunamıyor" ;;
        esac
        ;;
esac
