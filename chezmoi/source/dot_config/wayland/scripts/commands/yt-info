#!/usr/bin/env bash
set -euo pipefail
url="${1:-}"
[[ "$url" =~ ^https?:// ]] || { printf 'Kullanim: yt-info URL\n' >&2; exit 2; }
for cmd in yt-dlp fzf; do command -v "$cmd" >/dev/null || { printf '%s bulunamadi.\n' "$cmd" >&2; exit 127; }; done
choice="$(printf '%s\n' 'Genel bilgi' 'Video formatlari' 'Altyazilar' 'JSON metadata' | fzf --prompt='Bilgi > ' --height=40% --border)"
[[ -n "$choice" ]] || exit 0
case "$choice" in
  'Genel bilgi') yt-dlp --skip-download --print $'Baslik: %(title)s\nKanal: %(uploader)s\nSure: %(duration_string)s\nTarih: %(upload_date)s\nID: %(id)s\nURL: %(webpage_url)s' "$url" ;;
  'Video formatlari') yt-dlp -F "$url" ;;
  'Altyazilar') yt-dlp --list-subs "$url" ;;
  'JSON metadata') yt-dlp -J "$url" ;;
esac
