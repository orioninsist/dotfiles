#!/usr/bin/env bash

set -euo pipefail

CHROME_DIR="$HOME/.config/google-chrome"

echo "===== CHROME WEB APPS ====="
echo

if [[ ! -d "$CHROME_DIR" ]]; then
    echo "Chrome config bulunamadı:"
    echo "$CHROME_DIR"
    exit 1
fi

find "$CHROME_DIR" \
    -type f \
    -name "Preferences" \
    2>/dev/null |
while read -r file; do
    echo "PROFILE:"
    echo "$file"
    echo

    grep -iE \
    'app_id|web_app|installed|127\.0\.0\.1|localhost' \
    "$file" 2>/dev/null || true

    echo
done

echo "===== WEB APPLICATION PATHS ====="
find "$CHROME_DIR" \
    -type d \
    -path "*Web Applications*" \
    2>/dev/null || true
